<script>
// چند تا CDN پشت سر هم امتحان می‌کنیم — چون jsdelivr گاهی تو بعضی نت‌ها فیلتر/کند میشه و نمودار خالی می‌مونه.
// اگه همه‌شون شکست بخورن، بعداً هروقت لازم شد (باز کردن تب امتیازات) دوباره امتحان می‌کنیم، نه فقط یه‌بار موقع لود صفحه.
window.__chartJsSources = [
  'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js',
  'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js',
  'https://unpkg.com/chart.js@4.4.4/dist/chart.umd.min.js'
];
window.__chartJsPromise = null;
function ensureChartJs(){
  if(typeof Chart !== 'undefined') return Promise.resolve(true);
  if(window.__chartJsPromise) return window.__chartJsPromise;
  window.__chartJsPromise = (async ()=>{
    for(const src of window.__chartJsSources){
      try{
        await new Promise((resolve, reject)=>{
          const s = document.createElement('script');
          s.src = src + (src.includes('?') ? '&' : '?') + '_cb=' + Date.now(); s.onload = resolve; s.onerror = reject;
          // بدون این تایم‌اوت، اگه CDN کند/فیلتر بود مرورگر ممکن بود ده‌ها ثانیه (یا بیشتر) بی‌نهایت منتظر بمونه
          // و تا اون موقع نمودار اصلاً هیچی نشون نمی‌داد — همون علت اصلی «نمودار دیر میاد یا نمیاد»
          setTimeout(()=>reject(new Error('chartjs-timeout')), 3000);
          document.head.appendChild(s);
        });
        if(typeof Chart !== 'undefined') return true;
      }catch(e){ /* برو سراغ منبع بعدی */ }
    }
    window.__chartJsPromise = null; // شکست خورد — دفعه‌ی بعد دوباره امتحان کن، شاید نت وصل شده باشه
    return false;
  })();
  return window.__chartJsPromise;
}
function ensureSupabaseLib(){
  if(typeof supabase !== 'undefined') return Promise.resolve(true);
  if(window.__supabasePromise) return window.__supabasePromise;
  const urls = [
    'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js',
    'https://cdnjs.cloudflare.com/ajax/libs/supabase-js/2.45.4/supabase.min.js',
    'https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js'
  ];
  window.__supabasePromise = (async () => {
    for(const url of urls){
      try{
        await new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = url;
          s.onload = resolve;
          s.onerror = reject;
          // اگه تو بدترین شرایط نت هم گیر کرد، بیشتر از ۶ ثانیه معطلش نمی‌کنیم و میریم سراغ CDN بعدی
          setTimeout(reject, 6000);
          document.head.appendChild(s);
        });
        if(typeof supabase !== 'undefined') return true;
      }catch(e){ /* برو سراغ CDN بعدی */ }
    }
    window.__supabasePromise = null; // شکست خورد؛ دفعه‌ی بعد (مثلاً وقتی نت وصل شد) دوباره امتحان کن
    return false;
  })();
  return window.__supabasePromise;
}
</script>
