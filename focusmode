async function migrateStorageKey(oldKey, newKey){
  try{
    const r = await window.storage.get(oldKey, true);
    if(r && r.value){
      await window.storage.set(newKey, r.value, true);
      await window.storage.delete(oldKey, true);
    }
  }catch(e){ console.error('migrate failed', oldKey, newKey, e); }
}
async function migrateMemberCode(oldCode, newCode){
  if(oldCode===newCode) return;
  const mentors = await loadMentorRegistry();
  await Promise.all([
    migrateStorageKey('categories:'+oldCode, 'categories:'+newCode),
    migrateStorageKey('daily:'+oldCode, 'daily:'+newCode),
    migrateStorageKey('feedback:'+oldCode, 'feedback:'+newCode),
    migrateStorageKey('achv:'+oldCode, 'achv:'+newCode),
    migrateStorageKey('thread_admin:'+oldCode, 'thread_admin:'+newCode),
    migrateStorageKey('seenupdates:'+oldCode, 'seenupdates:'+newCode),
    migrateStorageKey('presence:'+oldCode, 'presence:'+newCode),
    ...mentors.map(m=>migrateStorageKey('thread_mentor:'+m.code+':'+oldCode, 'thread_mentor:'+m.code+':'+newCode))
  ]);
}
async function migrateMentorCode(oldCode, newCode){
  if(oldCode===newCode) return;
  const members = await loadMemberRegistry();
  await Promise.all([
    migrateStorageKey('achv:'+oldCode, 'achv:'+newCode),
    migrateStorageKey('thread_mentor_admin:'+oldCode, 'thread_mentor_admin:'+newCode),
    migrateStorageKey('seenupdates:'+oldCode, 'seenupdates:'+newCode),
    migrateStorageKey('presence:'+oldCode, 'presence:'+newCode),
    ...members.map(mem=>migrateStorageKey('thread_mentor:'+oldCode+':'+mem.code, 'thread_mentor:'+newCode+':'+mem.code))
  ]);
}

