function sortedDates(){ return Object.keys(dailyRecords).sort(); }

// ---------- سیستم دوره‌ی تقویمی (شنبه تا چهارشنبه، ۴ هفته = ۱ ماه) ----------
function addDays(isoDate, n){
  const d = new Date(isoDate+'T12:00:00');
  d.setDate(d.getDate()+n);
  return d.toISOString().slice(0,10);
}
function mostRecentSaturday(isoDate){
  const d = new Date(isoDate+'T12:00:00');
  const diff = (d.getDay()+1)%7; // فاصله‌ی روزهای گذشته از آخرین شنبه (شنبه=۰،یکشنبه=۱،...جمعه=۶)
  return addDays(isoDate, -diff);
}
function nextSaturdayOnOrAfter(isoDate){ // اولین شنبه‌ای که هم‌زمان یا بعد از این تاریخه (برای شروع درست دوره‌ی بعدی)
  const d = new Date(isoDate+'T12:00:00');
  const diff = (6 - d.getDay() + 7) % 7;
  return addDays(isoDate, diff);
}
// تشخیص و رفع خودکار تداخل دوره — اگه دوره‌ی جاری یه کاربر با آخرین ماه آرشیوشده‌ش هم‌پوشانی داره (چه به‌خاطر باگ قدیمی،
// چه به هر دلیل دیگه)، خودکار و بی‌سروصدا اصلاحش می‌کنیم؛ دیگه نیازی به ریست دستی نیست، برای همه‌ی کاربرا خودش انجام میشه.
async function healCycleOverlapIfNeeded(code, cs, hist){
  if(!cs || !hist || !hist.length) return cs;
  const lastEnd = hist[hist.length-1].weeks[3].dates[4];
  const earliestAllowed = nextSaturdayOnOrAfter(addDays(lastEnd, 1));
  if(cs < earliestAllowed){
    await saveCycleStart(code, earliestAllowed);
    return earliestAllowed;
  }
  return cs;
}
function weekDates(cycleStart, w){ // ۵ تاریخ (شنبه تا چهارشنبه) هفته‌ی w (۰-ایندکس) از شروع دوره
  const base = addDays(cycleStart, w*7);
  return [0,1,2,3,4].map(i=>addDays(base,i));
}
function allCycleDates(cycleStart){
  const all = [];
  for(let w=0; w<4; w++) all.push(...weekDates(cycleStart, w));
  return all; // دقیقاً ۲۰ تاریخ
}
function iranNowDateTimeStr(){
  const p = new Intl.DateTimeFormat('en-CA', { timeZone:'Asia/Tehran', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', hour12:false }).formatToParts(new Date());
  const g = t=>p.find(x=>x.type===t).value;
  return `${g('year')}-${g('month')}-${g('day')}T${g('hour')}:${g('minute')}`;
}
function weekRevealed(cycleStart, w){
  // نمره‌ی هفته دقیقاً ساعت ۱۲:۱۰ بامداد پنجشنبه (۱۰ دقیقه بعد از نیمه‌شب چهارشنبه) اعلام میشه
  const wed = weekDates(cycleStart, w)[4];
  const threshold = addDays(wed,1)+'T00:10';
  return iranNowDateTimeStr() >= threshold;
}
let _cycleStartCache = {}; // کد → مقدار — بعد از اولین بار، دیگه لازم نیست هر بار از دیتابیس بخونه (همون دلیل تأخیر ۲دقیقه‌ای بود)
async function loadCycleStart(code){
  if(Object.prototype.hasOwnProperty.call(_cycleStartCache, code)) return _cycleStartCache[code];
  try{ const r = await window.storage.get('cyclestart:'+code, true); const v = r && r.value ? JSON.parse(r.value) : null; _cycleStartCache[code] = v; return v; }
  catch(e){ return null; }
}
async function saveCycleStart(code, val){
  _cycleStartCache[code] = val; // آپدیت فوری حافظه — نمودار و آمار دیگه معطل دیتابیس نمی‌مونن
  try{ await window.storage.set('cyclestart:'+code, JSON.stringify(val), true); }catch(e){ console.error(e); }
}
// همه‌ی محاسبات دوره‌ی فعلی کاربر رو برمی‌گردونه — هیچ داده‌ای رو تغییر نمی‌ده، فقط dailyRecords رو بازخوانی می‌کنه
function computeCycle(cycleStart){
  if(!cycleStart) return null;
  const weeks = [];
  for(let w=0; w<4; w++){
    const dates = weekDates(cycleStart, w);
    const revealed = weekRevealed(cycleStart, w);
    const scores = dates.map(d=>dailyRecords[d] ? dailyRecords[d].dailyScore : 0);
    const score = scores.reduce((a,b)=>a+b,0)/5;
    const st = revealed ? weeklyStatus(score) : null;
    weeks.push({ index:w+1, dates, scores, score, revealed, grade:st?st.grade:null, label:st?st.label:null, cls:st?st.cls:null });
  }
  const monthComplete = weeks[3].revealed;
  let monthInfo = null;
  if(monthComplete){
    const monthScore = weeks.reduce((a,w)=>a+w.score,0)/4;
    const st = monthlyStatus(monthScore);
    monthInfo = { score:monthScore, grade:st.grade, label:st.label, cls:st.cls };
  }
  const todayISO = iranTodayISO();
  const dayIndex = Math.min(allCycleDates(cycleStart).filter(d=>d<=todayISO).length, 20);
  const currentWeekIndex = weeks.findIndex(w=>!w.revealed)+1 || 4;
  return { cycleStart, weeks, monthComplete, monthInfo, dayIndex, currentWeekIndex };
}
function weeklyStatus(s){ if(s<=49) return {label:'افتضاح',grade:'D+',cls:'bad'}; if(s<=69) return {label:'متوسط',grade:'C+',cls:'bad'}; if(s<=79) return {label:'خوب',grade:'B+',cls:'mid'}; return {label:'عالی',grade:'A+',cls:'good'}; }
function monthlyStatus(s){ if(s<=49) return {label:'افتضاح',grade:'D+',cls:'bad'}; if(s<=69) return {label:'متوسط',grade:'C+',cls:'bad'}; if(s<=79) return {label:'خوب',grade:'B+',cls:'mid'}; return {label:'عالی',grade:'A+',cls:'good'}; }

let _monthHistoryCache = {};
// اگه دو تا ماهِ آرشیوشده تو تاریخچه، تاریخ‌هاشون تداخل/هم‌پوشانی داشته باشن (به‌خاطر باگ قدیمی)، اینجا خودکار پاکسازی میشه.
// ماهِ بعدیِ خراب/تکراری حذف میشه (فقط رکورد خلاصه‌ی تاریخچه، نه امتیازهای روزانه‌ی خودِ کاربر که دست‌نخورده می‌مونه)
// و شماره‌ی ماه‌ها هم دوباره درست مرتب میشه.
function repairOverlappingMonthHistory(hist){
  if(!hist || hist.length<2) return {list:hist, changed:false};
  const sorted = hist.slice().sort((a,b)=> a.cycleStart<b.cycleStart ? -1 : (a.cycleStart>b.cycleStart?1:0));
  const clean = [sorted[0]];
  let changed = false;
  for(let i=1;i<sorted.length;i++){
    const prev = clean[clean.length-1];
    const prevEnd = prev.weeks[3].dates[4];
    const curStart = sorted[i].weeks[0].dates[0];
    if(curStart <= prevEnd){ changed = true; continue; } // تداخل دارن — این یکی حذف میشه
    clean.push(sorted[i]);
  }
  clean.forEach((m,i)=>{ if(m.index !== i+1){ m.index = i+1; changed = true; } });
  return {list:clean, changed};
}
async function loadMonthHistory(code){
  if(Object.prototype.hasOwnProperty.call(_monthHistoryCache, code)) return _monthHistoryCache[code];
  try{
    const r = await window.storage.get('monthhistory:'+code, true);
    let v = r && r.value ? JSON.parse(r.value) : [];
    const repaired = repairOverlappingMonthHistory(v);
    v = repaired.list;
    _monthHistoryCache[code] = v;
    if(repaired.changed){ await saveMonthHistory(code, v); } // پاکسازی رو همیشگی می‌کنیم، دیگه هر بار لازم نیست دوباره چک بشه
    return v;
  }
  catch(e){ return []; }
}
async function saveMonthHistory(code, list){
  _monthHistoryCache[code] = list;
  try{ await window.storage.set('monthhistory:'+code, JSON.stringify(list), true); }catch(e){ console.error(e); }
}
// اگه ماه کامل شده، به تاریخچه اضافه‌ش می‌کنه (اگه قبلاً نشده) و دوره رو برای شروع ماه بعد پاک می‌کنه
async function archiveCompletedCycleIfNeeded(code, cycleStart, info){
  if(!info || !info.monthComplete) return false;
  const hist = await loadMonthHistory(code);
  if(hist.some(m=>m.cycleStart===cycleStart)) return false; // قبلاً آرشیو شده
  hist.push({ index:hist.length+1, cycleStart, weeks:info.weeks, score:info.monthInfo.score, grade:info.monthInfo.grade, label:info.monthInfo.label, completedAt:iranTodayISO() });
  await saveMonthHistory(code, hist);
  await saveCycleStart(code, null);
  return true;
}
