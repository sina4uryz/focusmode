      <svg viewBox="0 0 44 44">
        <defs><linearGradient id="crRingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#BFDCF5"/><stop offset="100%" stop-color="#6FA8DC"/>
        </linearGradient></defs>
        <circle class="cr-ring-bg" cx="22" cy="22" r="${R}"></circle>
        <circle class="cr-ring-fill" cx="22" cy="22" r="${R}" stroke-dasharray="${dash} ${C}"></circle>
      </svg>
      <span class="cr-ring-num">${info.dayIndex}</span>
    </div>
    <div>
      <div class="cr-title2">روز <b>${info.dayIndex}</b> از ۲۰</div>
      <span class="cr-week-tag">هفته ${info.currentWeekIndex} از ۴</span>
      <div class="cr-sub" style="margin-top:5px;">امتیاز این هفته پنجشنبه ساعت ۱۲:۱۰ بامداد اعلام میشه</div>
    </div>
  </div>`;
}

