  /* ============ چک‌باکس‌ها — دایره‌ای، آبی پررنگ یکدست با بقیه‌ی سلکتورهای سایت، تیک سفید ============ */
  input[type=checkbox]{
    appearance:none; -webkit-appearance:none; width:24px; height:24px; border-radius:50%;
    border:1.5px solid rgba(255,255,255,.18); background:linear-gradient(160deg, rgba(255,255,255,.06), rgba(255,255,255,0));
    cursor:pointer; position:relative; flex-shrink:0;
    box-shadow:inset 0 1px 5px rgba(0,0,0,.35);
    transition:border-color .2s, box-shadow .2s, background .2s;
  }
  input[type=checkbox]:hover{ border-color:#2E7CE6; }
  input[type=checkbox]:checked{
    background:linear-gradient(135deg, #2E7CE6, #1D4ED8);
    border-color:transparent;
    box-shadow:0 4px 14px rgba(37,99,235,.45), inset 0 1px 0 rgba(255,255,255,.25);
  }
  input[type=checkbox]:checked::after{
    content:''; position:absolute; left:6px; top:7.5px; width:12px; height:9px;
    background:#FFFFFF;
    clip-path:polygon(9% 43%, 0 55%, 33% 88%, 100% 15%, 87% 0%, 33% 62%);
  }
  /* ============ انیمیشنِ تیک‌خوردن خفن‌تر — رو همه‌ی چک‌باکس‌های سایت ============ */
  input[type=checkbox]:checked{
    animation:chkBoxPop .4s cubic-bezier(.34,1.76,.64,1);
  }
  input[type=checkbox]:checked::after{
    transform-origin:center;
    animation:chkTickDraw .35s .05s cubic-bezier(.34,1.76,.64,1) both;
  }
  input[type=checkbox]:checked::before{
    content:''; position:absolute; inset:-4px; border-radius:50%; pointer-events:none;
    border:2px solid #2E7CE6;
    animation:chkRingBurst .55s ease-out;
  }
  @keyframes chkBoxPop{
    0%{ transform:scale(.7); }
    55%{ transform:scale(1.18); }
    100%{ transform:scale(1); }
  }
  @keyframes chkTickDraw{
    0%{ transform:scale(0); opacity:0; }
    60%{ transform:scale(1.3); opacity:1; }
    100%{ transform:scale(1); opacity:1; }
  }
  @keyframes chkRingBurst{
    0%{ transform:scale(.55); opacity:.95; }
    100%{ transform:scale(1.7); opacity:0; }
  }
