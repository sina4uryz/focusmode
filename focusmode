function iranTodayISO(){
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone:'Asia/Tehran', year:'numeric', month:'2-digit', day:'2-digit' }).formatToParts(new Date());
  const y = parts.find(p=>p.type==='year').value, m = parts.find(p=>p.type==='month').value, d = parts.find(p=>p.type==='day').value;
  return `${y}-${m}-${d}`;
}
// تبدیل یه تاریخ (به فرمت YYYY-MM-DD) به تاریخ شمسی برای نمایش
function iranJalaliDate(isoDate){
  const dateObj = new Date(isoDate+'T12:00:00');
  try{ return dateObj.toLocaleDateString('fa-IR-u-ca-persian', { timeZone:'Asia/Tehran', year:'numeric', month:'long', day:'numeric' }); }
  catch(e){ return dateObj.toLocaleDateString('fa-IR', { timeZone:'Asia/Tehran' }); }
}
function iranJalaliShort(isoDate){
  const dateObj = new Date(isoDate+'T12:00:00');
  try{ return dateObj.toLocaleDateString('fa-IR-u-ca-persian', { timeZone:'Asia/Tehran', month:'long', day:'numeric' }); }
  catch(e){ return isoDate; }
}
function iranWeekday(isoDate){
  const dateObj = new Date(isoDate+'T12:00:00');
  return dateObj.toLocaleDateString('fa-IR', { timeZone:'Asia/Tehran', weekday:'long' });
}
