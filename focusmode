  body{margin:0;background:var(--black);color:var(--white);font-family:'Vazirmatn',sans-serif;font-weight:500;letter-spacing:.1px;min-height:100vh;}
  .wrap{max-width:960px;margin:0 auto;padding:20px 16px 60px;}
  .hidden{display:none !important;}

  /* ---------- login screen ---------- */
  #loginScreen{
    position:relative;overflow:hidden;
    min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:20px;flex-direction:column;gap:18px;
    background:var(--black);
  }
  #loginScreen::before{
    content:'';position:absolute;inset:-8%;z-index:-1;
    background:
      radial-gradient(700px 420px at 15% 10%, rgba(45,168,150,.45), transparent 62%),
      radial-gradient(700px 460px at 85% 30%, rgba(62,95,203,.5), transparent 62%),
      radial-gradient(600px 600px at 50% 100%, rgba(20,30,55,.75), transparent 70%);
    animation:loginGradientMove 14s ease-in-out infinite alternate;
    will-change:transform;
    transform:translateZ(0);
    backface-visibility:hidden;
  }
  body.light #loginScreen::before{ animation:none; background:none; }
  @keyframes loginGradientMove{
    0%{ transform:translate3d(0,0,0) rotate(0deg); }
    50%{ transform:translate3d(-4%,3%,0) rotate(4deg); }
    100%{ transform:translate3d(4%,-3%,0) rotate(-4deg); }
  }
  .id-card{
    width:100%;max-width:420px;position:relative;overflow:hidden;border-radius:22px;padding:26px;
    background:rgba(27,34,51,0.42);
    border:1px solid rgba(255,255,255,0.16);
    box-shadow:0 12px 40px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.10), inset 0 0 40px rgba(255,255,255,.03), 0 0 70px 14px rgba(111,168,220,.22);
    backdrop-filter:blur(12px) saturate(160%);
    -webkit-backdrop-filter:blur(12px) saturate(160%);
  }
  .id-card::before{
    content:'';position:absolute;top:0;right:0;left:0;height:4px;
    background:linear-gradient(90deg, #FF3B6B, #FFC93B, #6BFF8F, #3BC5FF, #A63BFF, #FF3B6B);
    background-size:400% 100%;
    animation:idLineFlow 10s linear infinite;
    box-shadow:0 0 10px 2px rgba(120,140,255,.6), 0 0 22px 4px rgba(255,80,150,.35);
  }
  .id-card::after{
    content:'';position:absolute;bottom:0;right:0;left:0;height:4px;
    background:linear-gradient(90deg, #FF3B6B, #FFC93B, #6BFF8F, #3BC5FF, #A63BFF, #FF3B6B);
    background-size:400% 100%;
    animation:idLineFlow 10s linear infinite reverse;
    box-shadow:0 0 10px 2px rgba(120,140,255,.6), 0 0 22px 4px rgba(255,80,150,.35);
  }
  @keyframes idLineFlow{ to{ background-position:400% 0; } }
  .id-card h1{font-size:19px;font-weight:800;margin:6px 0 2px;}
  .id-card .sub{color:var(--white-dim);font-size:12px;margin-bottom:14px;}

  .quote-line{
    max-width:420px;width:100%;text-align:center;font-size:15.5px;font-weight:800;padding:12px 10px;
    background:linear-gradient(100deg,var(--navy) 20%, var(--lightblue) 50%, var(--navy) 80%);
    background-size:220% 100%; -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:shine 5s ease-in-out 3; cursor:default; letter-spacing:.3px; line-height:1.7;
  }
  .quote-line:hover{animation:shineFast 1.1s ease-in-out infinite;}
  @keyframes shine{0%{background-position:180% 0;}50%{background-position:0% 0;}100%{background-position:-180% 0;}}
  @keyframes shineFast{0%{background-position:220% 0;filter:brightness(1);}50%{background-position:0% 0;filter:brightness(1.6);}100%{background-position:-220% 0;filter:brightness(1);}}

  .brand-title{
    font-size:20px;font-weight:800;margin:6px 0 2px;letter-spacing:.5px;
    background:linear-gradient(100deg,var(--white) 20%, #ffffff 50%, var(--white) 80%);
    background-size:220% 100%; -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:shine 5s ease-in-out 3; text-shadow:0 0 10px rgba(255,255,255,.35);
  }
  .brand-title:hover{animation:shineFast 1.1s ease-in-out infinite;}

  .mode-switch{
    display:flex;gap:6px;margin-bottom:18px;position:relative;overflow:hidden;
