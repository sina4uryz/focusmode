async function stopPresenceHeartbeat(){
  if(presenceInterval){ clearInterval(presenceInterval); presenceInterval = null; }
  // به‌محض خروج، فوراً وضعیت رو آفلاین کن (دیگه نیازی به صبر کردن تا انقضای TTL یا رفرش صفحه نیست)
  if(currentPresenceCode){
    try{ await window.storage.delete('presence:'+currentPresenceCode, true); }catch(e){}
    currentPresenceCode = null;
  }
}
async function isOnline(code){
  try{
    const r = await window.storage.get('presence:'+code, true);
    if(!r || !r.value) return false;
    return (Date.now() - Number(r.value)) < PRESENCE_TTL;
  }catch(e){ return false; }
}
// mode: 'member' → فقط منتورهای آنلاین / 'mentor' → همه‌ی کاربرا با وضعیت / 'admin' → همه‌ی کاربرا و منتورها با وضعیت
async function renderStatusPanel(panelId, mode){
  const el = document.getElementById(panelId);
  if(!el) return;
  currentStatusRefresh = ()=>renderStatusPanel(panelId, mode);
  if(el.children.length===0) el.innerHTML = '<div class="card status-card"><div class="empty">در حال بررسی وضعیت...</div></div>';
  let html = '';
  if(mode==='member'){
    const mentors = (await loadMentorRegistry()).filter(m=>!m.deleted);
    const flags = await Promise.all(mentors.map(m=>isOnline(m.code)));
    const online = mentors.filter((m,i)=>flags[i]);
    html += `<div class="card status-card"><h2>${icon('signal')} Status — منتورهای آنلاین</h2>`;
    if(online.length===0){ html += '<div class="empty">در حال حاضر منتوری آنلاین نیست</div>'; }
    else{
      online.forEach(m=>{
        html += `<div class="del-row"><div><span class="badge-dot" style="box-shadow:0 0 6px 2px var(--lightblue);background:var(--lightblue);"></span> <b>${escapeHtml(m.name)}</b> آنلاین است</div><div class="cd">می‌تونی از «Connect To Team» پیام بدی</div></div>`;
      });
    }
    html += '</div>';
  }else{
    const members = (await loadMemberRegistry()).filter(m=>!m.deleted && !(mode==='mentor' && m.hideFromMentor));
    let mentors = [];
    if(mode==='admin') mentors = (await loadMentorRegistry()).filter(m=>!m.deleted);
    const memberFlags = await Promise.all(members.map(m=>isOnline(m.code)));
    html += `<div class="card status-card"><h2>${icon('signal')} Status — کاربران</h2>`;
    members.forEach((m,i)=>{
      const on = memberFlags[i];
      html += `<div class="del-row"><div><span class="badge-dot" style="box-shadow:0 0 6px 2px ${on?'var(--lightblue)':'var(--gray)'};background:${on?'var(--lightblue)':'var(--gray)'};"></span> ${escapeHtml(m.name)}</div><div class="cd">${on?'آنلاین':'آفلاین'}</div></div>`;
    });
    html += '</div>';
    if(mode==='admin'){
      const mentorFlags = await Promise.all(mentors.map(m=>isOnline(m.code)));
      html += `<div class="card status-card"><h2>${icon('signal')} Status — منتورها</h2>`;
      mentors.forEach((m,i)=>{
        const on = mentorFlags[i];
        html += `<div class="del-row"><div><span class="badge-dot" style="box-shadow:0 0 6px 2px ${on?'var(--lightblue)':'var(--gray)'};background:${on?'var(--lightblue)':'var(--gray)'};"></span> ${escapeHtml(m.name)}</div><div class="cd">${on?'آنلاین':'آفلاین'}</div></div>`;
      });
      html += '</div>';
    }
  }
  el.innerHTML = html;
}

async function loadUpdates(){
  try{ const r = await window.storage.get('updates', true); return r && r.value ? JSON.parse(r.value) : []; }
  catch(e){ return []; }
}
async function saveUpdates(list){
  try{ await window.storage.set('updates', JSON.stringify(list), true); }catch(e){ console.error(e); }
}
async function postUpdate(authorRole, authorName, text){
  const list = await loadUpdates();
  list.push({ id:uid(), authorRole, authorName, text, date:new Date().toISOString().slice(0,10), ts:Date.now() });
  await saveUpdates(list);
}
async function deleteUpdate(updateId){
  const list = await loadUpdates();
  await saveUpdates(list.filter(u=>u.id!==updateId));
}
async function loadLastSeenUpdates(viewerCode){
  try{ const r = await window.storage.get('seenupdates:'+viewerCode, true); return r && r.value ? Number(r.value) : 0; }
  catch(e){ return 0; }
}
async function markUpdatesSeen(viewerCode){
  try{ await window.storage.set('seenupdates:'+viewerCode, String(Date.now()), true); }catch(e){ console.error(e); }
}
async function checkUpdatesBadge(viewerCode, badgeElId){
  const badge = document.getElementById(badgeElId);
  if(!badge) return;
  const list = await loadUpdates();
  if(list.length===0){ badge.classList.add('hidden'); return; }
  const lastSeen = await loadLastSeenUpdates(viewerCode);
  const latest = Math.max(...list.map(u=>u.ts||0));
  badge.classList.toggle('hidden', latest <= lastSeen);
}
// panelId رو با فید اپدیت پر می‌کنه؛ اگه canPost=true یه فرم ارسال هم می‌ذاره (برای رئیس/منتور)
async function renderUpdatesPanel(panelId, viewerCode, canPost, authorRole, authorName){
  const el = document.getElementById(panelId);
  if(!el) return;
  const list = await loadUpdates();
  let html = '';
  if(canPost){
    html += `<div class="card"><h2>ارسال اپدیت جدید (برای همه کاربرا و منتورها)</h2>
      <textarea id="updateInput_${panelId}" placeholder="مثلاً: تغییرات این هفته..."></textarea>
      <div style="margin-top:10px;"><button class="btn small" id="updateBtn_${panelId}">ارسال به همه</button></div>
    </div>`;
  }
  html += `<div class="card updates-card"><h2>${icon('megaphone')} اپدیت‌ها</h2><div id="updatesList_${panelId}"></div></div>`;
  el.innerHTML = html;
  const uWrap = el.querySelector('#updatesList_'+panelId);
  let liveList = list.slice();
  function paintUpdates(){
    if(liveList.length===0){ uWrap.innerHTML = '<div class="empty">هنوز اپدیتی ثبت نشده</div>'; return; }
    let h = '';
    liveList.slice().reverse().forEach(u=>{
      const authorLabel = u.authorRole==='admin' ? 'از طرف مدیر' : `از طرف منتور ${escapeHtml(u.authorName||'')}`;
      const canDelete = canPost && (authorRole==='admin' || (u.authorRole===authorRole && u.authorName===authorName));
      h += `<div class="update-card"><div>${escapeHtml(u.text)}</div><div class="meta">${authorLabel} · ${iranJalaliDate(u.date)}${u.ts?` · ساعت ${iranTimeFromTs(u.ts)}`:''}${canDelete?` <button class="icon-btn" data-del-update="${u.id}" title="حذف" style="margin-right:8px;">✕</button>`:''}</div></div>`;
    });
    uWrap.innerHTML = h;
    uWrap.querySelectorAll('[data-del-update]').forEach(btn=>btn.addEventListener('click', guard(btn, async ()=>{
      liveList = liveList.filter(u=>u.id!==btn.dataset.delUpdate);
      paintUpdates(); // حذف فوری
      showToast('اپدیت حذف شد');
      await deleteUpdate(btn.dataset.delUpdate);
    })));
  }
  paintUpdates();
  if(canPost){
    const btn = el.querySelector('#updateBtn_'+panelId);
    btn.addEventListener('click', guard(btn, async ()=>{
      const ta = el.querySelector('#updateInput_'+panelId);
      const val = ta.value.trim();
      if(!val) return;
      ta.value='';
      const newUpdate = { id:uid(), authorRole, authorName, text:val, date:new Date().toISOString().slice(0,10), ts:Date.now() };
      liveList.push(newUpdate);
      paintUpdates(); // نمایش فوری
      showToast('اپدیت ارسال شد');
      await saveUpdates([...(await loadUpdates()), newUpdate]);
    }));
  }
}

