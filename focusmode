async function renderBootcampLeaderboard(panelId){
  const el = document.getElementById(panelId);
  if(!el) return;
  const members = (await loadMemberRegistry()).filter(m=>!m.deleted).map(m=>({code:m.code, name:m.name, role:'کاربر'}));
  const mentors = (await loadMentorRegistry()).filter(m=>!m.deleted).map(m=>({code:m.code, name:m.name, role:'منتور'}));
  const people = [...members, ...mentors];
  const lists = await Promise.all(people.map(p=>loadAchievements(p.code)));
  let rows = [];
  people.forEach((p,i)=>{
    const list = lists[i];
    if(list.length>0){
      const bestTier = Math.max(...list.map(a=>medalInfo(a.name||a.text).tier));
      const counts = {};
      list.forEach(a=>{ const n = a.name||a.text; counts[n] = (counts[n]||0)+1; });
      rows.push({ ...p, count:list.length, bestTier, counts, bestColor: medalInfo(MEDAL_TIERS.find(m=>m.tier===bestTier)?.name||'').color });
    }
  });
  rows.sort((a,b)=> b.bestTier - a.bestTier || b.count - a.count);
  let inner = `<h2>${icon('trophy')} لیدربورد افتخارات بوت‌کمپ</h2>`;
  if(rows.length===0){ inner += '<div class="empty">هنوز کسی مدالی نگرفته</div>'; }
  else{
    const prevRanks = await loadPrevRanks();
    const newRanks = {};
    rows.forEach((r,i)=>{ newRanks[r.code] = i; });
    const rankLabel = i => i===0?'نفر اول':i===1?'نفر دوم':i===2?'نفر سوم':`رتبه ${i+1}`;
    rows.forEach((r,i)=>{
      const prevRank = prevRanks[r.code];
      let arrowHtml = '';
      if(prevRank !== undefined && prevRank !== i){
        arrowHtml = prevRank > i
          ? `<span class="rank-arrow up" title="رتبه‌اش از دفعه‌ی قبل بالا رفته">${icon('arrowUp')}</span>`
          : `<span class="rank-arrow down" title="رتبه‌اش از دفعه‌ی قبل پایین اومده">${icon('arrowDown')}</span>`;
      }
      inner += `<div class="del-row"><div><b>${rankLabel(i)} — ${escapeHtml(r.name)}</b>${arrowHtml} <span class="cd">(${escapeHtml(r.role)})</span></div><div class="medal-summary" style="margin-inline-start:0;">${MEDAL_TIERS.filter(t=>r.counts[t.name]).map(t=>`<span class="medal-count-chip" style="--mc:${t.color};">${medalSVG(t.color)}<b>${r.counts[t.name]}</b></span>`).join('')}</div></div>`;
    });
    await savePrevRanks(newRanks);
  }
  // به‌جای اضافه‌کردنِ یه کارت جدید هر بار (که تکراری می‌شد و سایت رو سنگین می‌کرد)، همون کارت قبلی رو آپدیت می‌کنیم
  const wrapId = panelId + '_bootLbWrap';
  let wrap = document.getElementById(wrapId);
  if(!wrap){
    el.insertAdjacentHTML('beforeend', `<div class="card honor-card" id="${wrapId}"></div>`);
    wrap = document.getElementById(wrapId);
  }
  wrap.innerHTML = inner;
}

