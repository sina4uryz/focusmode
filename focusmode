// ================= Commitment — تعهدنامه با امضا؛ فقط کاربرا، قبل از ورود به پنل =================
const COMMITMENT_TTL_DAYS = 30;
async function loadCommitment(code){
  try{ const r = await window.storage.get('commitment:'+code, true); return r && r.value ? JSON.parse(r.value) : null; }
  catch(e){ return null; }
}
async function saveCommitment(code, obj){
  try{ await window.storage.set('commitment:'+code, JSON.stringify(obj), true); }catch(e){ console.error(e); }
}
function commitmentExpired(rec){
  if(!rec) return true;
  const days = (Date.now() - new Date(rec.date).getTime()) / 86400000;
  return days > COMMITMENT_TTL_DAYS;
}
async function renderCommitmentPanel(panelId, code, memberName, canReset){
  const el = document.getElementById(panelId);
  if(!el) return;
  const rec = await loadCommitment(code);
  if(!rec){ el.innerHTML = '<div class="card pledge-card"><div class="empty">هنوز تعهدنامه‌ای ثبت نشده</div></div>'; return; }
  el.innerHTML = `<div class="card pledge-card">
    <h2>${icon('signature')} Commitment</h2>
    <div class="fb-line"><b>نام:</b> ${escapeHtml(rec.name||memberName||'')}</div>
    <div class="fb-line"><b>تاریخ ثبت:</b> ${iranJalaliDate(rec.date)}${rec.time?` · ساعت ${rec.time}`:''}</div>
    <div class="fb-line" style="margin-top:8px;"><b>متن تعهد کاربر:</b></div>
    <div class="fb-line" style="white-space:pre-wrap;">${escapeHtml(rec.text)}</div>
    <div class="fb-line" style="margin-top:10px;"><b>امضا:</b></div>
    <div class="pledge-sig-frame">
      <img src="${rec.signature}">
    </div>
    ${commitmentExpired(rec)?`<div class="err-msg" style="margin-top:10px;">${icon('warnTriangle')} این تعهدنامه منقضی شده (بیش از یک ماه از ثبتش گذشته)</div>`:''}
    ${canReset?`<div style="margin-top:10px;"><button class="btn ghost small" id="forceResignBtn_${panelId}">لغو تعهدنامه و اجبار به امضای دوباره</button></div>`:''}
  </div>`;
  if(canReset){
    const btn = document.getElementById('forceResignBtn_'+panelId);
    btn.addEventListener('click', guard(btn, async ()=>{
      await saveCommitment(code, null);
      showToast('تعهدنامه لغو شد — کاربر باید دوباره امضا کنه');
      renderCommitmentPanel(panelId, code, memberName, canReset);
    }));
  }
}

// ============ پلنر — کاملاً جدا از تعهدنامه/چک‌لیست/امتیاز؛ می‌تونه چند پروژه داشته باشه ============
async function loadPlannerData(code){
  try{ const r = await window.storage.get('planner:'+code, true); return r && r.value ? JSON.parse(r.value) : []; }
  catch(e){ return []; }
}
async function savePlannerData(code, list){
  try{ await window.storage.set('planner:'+code, JSON.stringify(list), true); }catch(e){ console.error(e); }
}
function newPlannerProject(name){
  return { id:uid(), name: name||'پروژه جدید', caption:'', goal:'', tasks:'', rules:'', principles:'', done:[] };
}
async function renderPlannerPanel(panelId, code){
  const el = document.getElementById(panelId);
  if(!el) return;
  let list = await loadPlannerData(code);
  let activeId = list.length ? list[0].id : null;

  function fieldCard(title, key, rows, proj){
    return `<div class="card project-card">
      <h2>${title}</h2>
      ${rows===1
        ? `<input type="text" data-pf="${key}" value="${escapeHtml(proj[key]||'')}">`
        : `<textarea rows="${rows}" data-pf="${key}">${escapeHtml(proj[key]||'')}</textarea>`}
    </div>`;
  }

  function squaresHtml(proj){
    const doneSet = new Set(proj.done||[]); // کلید هر خونه: "b{شماره‌باکس}-{عدد}" چون هر باکس از ۱ تا ۱۰۰ دوباره شماره می‌خوره
    const boxNames = proj.boxNames || {};
    let boxesHtml = '';
    for(let b=0; b<10; b++){
      let cells = '';
      let boxDoneCount = 0;
      for(let i=1;i<=100;i++){
        const key = `b${b}-${i}`;
        const isDone = doneSet.has(key);
        if(isDone) boxDoneCount++;
        cells += `<div class="sq-cell${isDone?' done':''}" data-box="${b}" data-sq="${i}">${i}</div>`;
      }
      const boxLabel = boxNames[b] || `قسمت ${b+1}`;
      boxesHtml += `<div class="card project-card">
        <h2>${icon('target')}<input type="text" value="${escapeHtml(boxLabel)}" data-boxname="${b}" placeholder="اسم این قسمت رو بنویس" style="font-size:13px;font-weight:800;border:none;background:none;padding:0;color:#E79AAC;width:auto;flex:1;"> <span style="font-weight:400;color:var(--white-dim);font-size:11px;">(۱ تا ۱۰۰)</span></h2>
        <div class="sq-progress" data-boxprogress="${b}">${boxDoneCount} از ۱۰۰ کامل شده</div>
        <div class="sq-grid" data-sqgrid="${b}">${cells}</div>
      </div>`;
    }
    return boxesHtml;
  }

  function paintProjectPicker(){
    const pickerHtml = `<div class="card project-card">
      <h2>${icon('rocket')} پلنر — پروژه‌ها</h2>
      <div class="row-flex" style="align-items:center;">
        ${list.length ? `<select id="plannerPick" style="max-width:220px;">${list.map(p=>`<option value="${p.id}" ${p.id===activeId?'selected':''}>${escapeHtml(p.name||'بدون‌نام')}</option>`).join('')}</select>` : `<div class="empty" style="padding:6px 0;">هنوز پروژه‌ای ساخته نشده</div>`}
        <button class="btn ghost small" id="plannerAddBtn">${icon('rocket')} پروژه جدید</button>
        ${list.length ? `<button class="btn ghost small" id="plannerDelBtn" style="color:#E37272;border-color:rgba(227,114,114,.4);">حذف این پروژه</button>` : ''}
      </div>
    </div>`;
    return pickerHtml;
  }

  function paintProjectEditor(){
    if(!activeId) return '';
    const proj = list.find(p=>p.id===activeId);
