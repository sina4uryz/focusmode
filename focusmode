  try{ if(typeof currentCode !== 'undefined' && currentCode && !document.getElementById('mainApp').classList.contains('hidden')) updateHeaderStats(); }catch(e){}
}
(function(){
  const langBtn = document.getElementById('langToggle');
  const langMenu = document.getElementById('langMenu');
  langBtn.addEventListener('click', (e)=>{
    e.stopPropagation();
    langMenu.classList.toggle('hidden');
  });
  langMenu.querySelectorAll('button[data-lang]').forEach(b=>{
    b.addEventListener('click', ()=>{
      setLanguage(b.dataset.lang);
      langMenu.classList.add('hidden');
    });
  });
  document.addEventListener('click', (e)=>{
    if(!langMenu.contains(e.target) && e.target!==langBtn) langMenu.classList.add('hidden');
  });
  // اعمال زبان ذخیره‌شده (یا فارسی پیش‌فرض) به محض بارگذاری صفحه
  setLanguage(currentLang);
})();
