  const wWrap = document.getElementById('weeklyTable');
  let prevMonthsCompactHtml = '';
  if(monthHistory.length){
    const chips = monthHistory.map(m=>`<span class="week-day-chip" title="ماه ${m.index} — ${m.label}">ماه ${m.index} <b>${Math.round(m.score*10)/10} · ${m.grade}</b></span>`).join('');
