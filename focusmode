    color:#fff !important;
    border:1px solid rgba(111,168,220,.55) !important;
    backdrop-filter:blur(14px) saturate(220%);-webkit-backdrop-filter:blur(14px) saturate(220%);
    box-shadow:0 4px 20px rgba(37,99,235,.35), inset 0 1.5px 0 rgba(255,255,255,.55), inset 0 -2px 6px rgba(0,0,0,.1), inset 0 0 14px rgba(111,168,220,.14) !important;
    text-shadow:0 1px 3px rgba(0,0,0,.35);
    transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease !important;
  }
  .btn-glass-cta::after{
    content:'';position:absolute;inset:0;border-radius:inherit;background:radial-gradient(circle, rgba(255,255,255,.6) 0%, transparent 70%);
    opacity:0;transform:scale(.3);pointer-events:none;transition:opacity .5s ease, transform .5s ease;
  }
  .btn-glass-cta:active{ transform:scale(.92); }
  .btn-glass-cta:active::after{ opacity:1;transform:scale(1.5);transition:none; }
  .logout-btn:hover{background:#C94F4F;color:var(--white);}
  .back-btn{background:none;border:1px solid var(--line);color:var(--white-dim);border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;font-family:inherit;}
  .back-btn:hover{border-color:var(--lightblue);color:var(--lightblue);}

  .tabs{
    display:flex;gap:4px;margin-bottom:18px;position:relative;overflow-x:auto;overflow-y:hidden;
    background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.18);
    backdrop-filter:blur(12px) saturate(200%);-webkit-backdrop-filter:blur(12px) saturate(200%);
    border-radius:16px;padding:5px;
    box-shadow:inset 0 1.5px 0 rgba(255,255,255,.14), 0 8px 22px rgba(0,0,0,.3);
    transform:translateZ(0); will-change:transform;
    flex-wrap:nowrap;scrollbar-width:thin;
  }
  .tab-btn{background:none;border:none;color:var(--white-dim);font-family:inherit;font-size:13px;font-weight:600;padding:9px 13px;cursor:pointer;border-radius:11px;transition:.35s cubic-bezier(.34,1.56,.64,1);white-space:nowrap;flex-shrink:0;position:relative;z-index:1;box-shadow:inset 0 1px 0 rgba(255,255,255,.10);}
  .tab-btn:active{transform:scale(.92);}
  .tab-btn.active{
    color:#fff;
    background:linear-gradient(135deg, #2E7CE6, #1D4ED8);
    box-shadow:0 4px 14px rgba(37,99,235,.45), inset 0 1px 0 rgba(255,255,255,.25);
    border:1px solid transparent;
    text-shadow:0 1px 3px rgba(0,0,0,.25);
  }
  .tabs::-webkit-scrollbar{height:4px;}
  .tabs::-webkit-scrollbar-thumb{background:var(--line);border-radius:4px;}
  .tab-btn:hover{color:var(--white);}
  .panel{display:none;}
  @keyframes glassSwitchIn{
    0%{ opacity:0; transform:scale(.97) translateY(6px); }
    100%{ opacity:1; transform:scale(1) translateY(0); }
  }
  .panel.active.glass-anim, .chat-pv-wrap.glass-anim{ animation:glassSwitchIn .45s cubic-bezier(.22,1,.36,1); }
  .panel.active{display:block;animation:fade .25s ease;}
  @keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

  .card{
    background:linear-gradient(165deg, var(--navy), var(--navy-alt));
    border:1px solid rgba(111,168,220,0.18);border-radius:12px;padding:16px;margin-bottom:14px;
    box-shadow:0 6px 20px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.04);
  }
  .card h2{font-size:15px;font-weight:700;margin:0 0 12px;color:var(--white);}
  /* ============ سه بخش خاص: تعهدنامه / بازخورد / یادداشت شخصی ============ */
  .pledge-card{position:relative;overflow:hidden;border-color:rgba(230,196,102,.38);background:linear-gradient(160deg, rgba(230,196,102,.08), var(--navy-alt));}
  .pledge-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #E6C466, transparent);}
  .pledge-card h2{display:flex;align-items:center;gap:8px;color:#E6C466;}
  .pledge-sig-frame{border:1px solid rgba(230,196,102,.4);border-radius:10px;background:var(--navy-alt);padding:8px;display:inline-block;box-shadow:0 4px 14px rgba(0,0,0,.25);}
  .pledge-sig-frame img{max-width:280px;display:block;background:#F4F6F9;border:2px solid #E6C466;border-radius:8px;padding:4px;}
  .feedback-card{position:relative;border-color:rgba(124,196,169,.35);background:linear-gradient(160deg, rgba(124,196,169,.07), var(--navy-alt));}
  .feedback-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #7CC4A9, transparent);}
  .feedback-card h2{color:#8FD6BA;}
  .notes-card{position:relative;border-color:rgba(157,140,230,.35);background:linear-gradient(160deg, rgba(157,140,230,.07), var(--navy-alt));}
  .notes-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #9D8CE6, transparent);}
  .notes-card h2{color:#B9ACF2;}
  /* ============ بخش پروژه (بعد از تعهدنامه) — فقط وقتی مدیریت برای این کاربر فعالش کرده باشه نشون داده میشه ============ */
  .project-card{position:relative;border-color:rgba(217,108,130,.35);background:linear-gradient(160deg, rgba(217,108,130,.07), var(--navy-alt));}
  .project-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #D96C82, transparent);}
  .project-card h2{display:flex;align-items:center;gap:8px;color:#E79AAC;font-size:13px;}
  .project-card textarea, .project-card input[type=text]{width:100%;resize:vertical;}
  .sq-grid{
    display:grid;grid-template-columns:repeat(10, 36px);gap:8px;max-height:340px;overflow-y:auto;padding:6px;justify-content:start;
    contain:layout style paint; transform:translateZ(0); will-change:scroll-position;
  }
  .sq-cell{
    aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:9.5px;font-weight:800;
    border:1.5px solid rgba(255,255,255,.16);border-radius:50%;
    background:rgba(255,255,255,.04);
    color:var(--white-dim);cursor:pointer;user-select:none;position:relative;
    transition:border-color .15s;
  }
  .sq-cell:hover{border-color:#2E7CE6;}
  .sq-cell.done{
    background:linear-gradient(135deg, #2E7CE6, #1D4ED8);
    border-color:transparent;color:transparent;
    box-shadow:0 4px 12px rgba(37,99,235,.4);
    animation:chkBoxPop .4s cubic-bezier(.34,1.76,.64,1);
  }
  .sq-cell.done::after{
    content:''; position:absolute; left:50%; top:50%; width:13px; height:10px;
    margin:-6px 0 0 -6.5px; background:#FFFFFF;
    clip-path:polygon(9% 43%, 0 55%, 33% 88%, 100% 15%, 87% 0%, 33% 62%);
    animation:chkTickDraw .35s .05s cubic-bezier(.34,1.76,.64,1) both;
  }
  .sq-progress{font-size:11px;color:var(--white-dim);margin-bottom:8px;}
  /* پلنر شامل ۱۰ گرید ۱۰۰تایی با هم توی صفحه‌ست (۱۰۰۰ خونه)؛ اونایی که هنوز رو صفحه نیومدن،
     رندر/رنگ‌آمیزیشون رو مرورگر به تعویق می‌ندازه — همین لگ اسکرول رو حل می‌کنه */
  .project-card{content-visibility:auto; contain-intrinsic-size:0 420px;}
  /* ============ بخش‌های قوانین/اپدیت/افتخارات/وضعیت — همون خانواده‌ی طراحی، بدون انیمیشن (سبک و بی‌لگ) ============ */
  .rules-card{position:relative;overflow:hidden;border-color:rgba(93,201,217,.4);background:linear-gradient(160deg, rgba(93,201,217,.08), var(--navy-alt));}
  .rules-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #5DC9D9, transparent);}
  .rules-card h2{display:flex;align-items:center;gap:8px;color:#8FE0EC;}
  .updates-card{position:relative;overflow:hidden;border-color:rgba(230,124,92,.4);background:linear-gradient(160deg, rgba(230,124,92,.08), var(--navy-alt));}
  .updates-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #E67C5C, transparent);}
  .updates-card h2{display:flex;align-items:center;gap:8px;color:#F0A488;}
  .honor-card{position:relative;overflow:hidden;border-color:rgba(230,184,77,.4);background:linear-gradient(160deg, rgba(230,184,77,.08), var(--navy-alt));}
  .honor-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #E6B84D, transparent);}
  .honor-card h2{display:flex;align-items:center;gap:8px;color:#F0CD7C;}
  .medal-summary{display:flex;gap:6px;margin-inline-start:auto;flex-wrap:wrap;}
  .medal-count-chip{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid color-mix(in srgb, var(--mc) 45%, transparent);border-radius:20px;padding:2px 9px;font-size:12px;font-weight:800;color:var(--mc);}
  .medal-count-chip svg{width:13px;height:13px;flex-shrink:0;}
  .status-card{position:relative;overflow:hidden;border-color:rgba(92,217,160,.4);background:linear-gradient(160deg, rgba(92,217,160,.08), var(--navy-alt));}
  .status-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #5CD9A0, transparent);}
  .status-card h2{display:flex;align-items:center;gap:8px;color:#8DEBC0;}
  /* ============ قاب رتبه دور آواتار — بر اساس بهترین مدالی که گرفته ============ */
  .mc-avatar.rank-tier-1{ box-shadow:0 0 0 2px rgba(176,141,87,.9), 0 0 10px rgba(176,141,87,.65), inset 0 1px 0 rgba(255,255,255,.5); }
  .mc-avatar.rank-tier-2{ box-shadow:0 0 0 2px rgba(183,191,198,.95), 0 0 10px rgba(183,191,198,.65), inset 0 1px 0 rgba(255,255,255,.5); }
  .mc-avatar.rank-tier-3{ box-shadow:0 0 0 2.5px rgba(232,193,88,1), 0 0 14px rgba(232,193,88,.85), inset 0 1px 0 rgba(255,255,255,.5); }
  /* ============ صفحه‌ی جشنِ گرفتن مدال جدید ============ */
  .medal-celebration-overlay{
    position:fixed;inset:0;z-index:9999;background:rgba(8,12,20,.72);
    backdrop-filter:blur(6px) saturate(140%);-webkit-backdrop-filter:blur(6px) saturate(140%);
    display:flex;align-items:center;justify-content:center;padding:20px;
    animation:medalOverlayFade .25s ease-out;
  }
  @keyframes medalOverlayFade{ from{opacity:0;} to{opacity:1;} }
  .medal-celebration-card{
    background:linear-gradient(165deg, var(--navy), var(--navy-alt));
    border:1px solid rgba(232,193,88,.5);border-radius:18px;padding:34px 26px 26px;text-align:center;max-width:320px;width:100%;
    box-shadow:0 20px 60px rgba(0,0,0,.5), 0 0 40px -8px rgba(232,193,88,.5);
    animation:medalCardPop .45s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes medalCardPop{ from{transform:scale(.7);opacity:0;} to{transform:scale(1);opacity:1;} }
  .mc-medal-big{display:flex;justify-content:center;margin-bottom:12px;filter:drop-shadow(0 0 16px currentColor);}
  .mc-medal-big svg{width:64px;height:64px;}
  .mc-cel-title{font-size:14px;color:var(--white-dim);margin-bottom:6px;}
  .mc-cel-name{font-size:20px;font-weight:900;margin-bottom:22px;}
  /* ============ فلش صعود/نزول رتبه تو لیدربورد ============ */
  .rank-arrow{display:inline-flex;margin-inline-start:6px;}
  .rank-arrow.up{color:#7CC4A9;}
  .rank-arrow.down{color:#E68C8C;}
  /* ============ سه‌تایی بخش امتیازات: نمودار روزانه / هفتگی / ماهانه — همون الگوی بالا، با نوار متحرک ============ */
  .score-chart-card{position:relative;overflow:hidden;border-color:rgba(111,168,220,.4);background:linear-gradient(160deg, rgba(111,168,220,.08), var(--navy-alt));}
  .score-chart-card h2{display:flex;align-items:center;flex-wrap:wrap;gap:8px;}
  .chart-mode-switch{
    display:inline-flex;gap:2px;margin-right:auto;font-weight:600;
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:3px;
  }
  .chart-mode-switch button{
    -webkit-appearance:none;appearance:none;border:none;background:none;color:var(--white-dim);
    font-family:inherit;font-size:10.5px;font-weight:700;padding:5px 10px;border-radius:999px;cursor:pointer;
    transition:.25s cubic-bezier(.34,1.56,.64,1);-webkit-tap-highlight-color:transparent;
  }
  .chart-mode-switch button.active{color:#fff;background:linear-gradient(135deg, #2E7CE6, #1D4ED8);box-shadow:0 4px 14px rgba(37,99,235,.45), inset 0 1px 0 rgba(255,255,255,.25);}
  .score-chart-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #6FA8DC, #BFDCF5, #6FA8DC, transparent);box-shadow:0 0 10px 1px rgba(111,168,220,.4);}
  .score-chart-card h2{display:flex;align-items:center;gap:8px;color:#9CC5EE;}
  .score-week-card{position:relative;overflow:hidden;border-color:rgba(255,163,92,.4);background:linear-gradient(160deg, rgba(255,163,92,.08), var(--navy-alt));}
  .score-week-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #FFA35C, #FFD9AE, #FFA35C, transparent);box-shadow:0 0 10px 1px rgba(255,163,92,.4);}
  .score-week-card h2{display:flex;align-items:center;gap:8px;color:#FFC08A;}
  .score-month-card{position:relative;overflow:hidden;border-color:rgba(230,124,176,.4);background:linear-gradient(160deg, rgba(230,124,176,.08), var(--navy-alt));}
  .score-month-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg, transparent, #E67CB0, #F4B8D6, #E67CB0, transparent);box-shadow:0 0 10px 1px rgba(230,124,176,.4);}
  .score-month-card h2{display:flex;align-items:center;gap:8px;color:#F0A0CC;}
  /* ============ افزوده‌ی تزئینی بخش تسک‌ست/چک‌لیست — فقط اضافه‌شده، چیزی از قبل حذف نشده ============ */
  /* نور پشت کارت تسک‌ست حذف شد (باعث هنگ/لگ می‌شد) — به‌جاش یه هاله‌ی ثابت و سبک، بدون انیمیشن */
  .task-cat-card{ box-shadow:0 6px 20px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.04), 0 0 14px -4px var(--catColor, var(--lightblue)); }
  .task-progress-track{position:relative;}
  .task-progress-fill{position:relative;overflow:hidden;}
  .chk-row:has(input:checked){
    background:linear-gradient(90deg, color-mix(in srgb, var(--catColor, var(--lightblue)) 18%, transparent), transparent);
    border-color:var(--catColor, var(--lightblue));
    animation:chkPop .45s cubic-bezier(.34,1.56,.64,1);
  }
  .chk-row:has(input:checked) label{ color:var(--white-dim); text-decoration:line-through; text-decoration-color:var(--catColor, var(--lightblue)); }
  .chk-row:has(input:checked) .pts{ color:var(--catColor, var(--lightblue)); box-shadow:0 0 10px color-mix(in srgb, var(--catColor, var(--lightblue)) 55%, transparent); }
  @keyframes chkPop{
    0%{ box-shadow:0 0 0 0 color-mix(in srgb, var(--catColor, var(--lightblue)) 40%, transparent); }
    60%{ box-shadow:0 0 0 8px color-mix(in srgb, var(--catColor, var(--lightblue)) 0%, transparent); }
    100%{ box-shadow:0 0 0 0 color-mix(in srgb, var(--catColor, var(--lightblue)) 0%, transparent); }
  }
  .cat-head{display:flex;justify-content:space-between;align-items:center;gap:10px;}
  .cat-badge{font-size:11px;padding:4px 11px;border-radius:20px;font-weight:800;font-variant-numeric:tabular-nums;transition:.25s;}
  .cat-badge.ok{background:rgba(124,196,169,.18);color:#8FD6BA;box-shadow:0 0 10px rgba(124,196,169,.25);}
  .cat-badge.bad{background:rgba(255,255,255,.07);color:var(--white-dim);}
  .task-list{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;}
  @media (max-width:520px){ .task-list{grid-template-columns:1fr;} }
  /* ---- کارت دسته‌ی تسک: نوار رنگی + ایموجی + نوار پیشرفت ---- */
  .task-cat-card{position:relative;overflow:hidden;padding-right:20px;}
  .task-cat-card::before{content:'';position:absolute;top:0;bottom:0;right:0;width:4px;background:var(--catColor, var(--lightblue));box-shadow:0 0 12px var(--catColor, var(--lightblue));}
  .task-cat-emoji{display:inline-flex;align-items:center;color:var(--catColor, var(--lightblue));margin-left:6px;filter:drop-shadow(0 0 5px var(--catColor, transparent));}
  .task-progress-track{height:6px;border-radius:6px;background:rgba(255,255,255,.07);margin:12px 0 2px;overflow:hidden;}
  .task-progress-fill{height:100%;border-radius:6px;background:linear-gradient(90deg, var(--catColor, var(--lightblue)), color-mix(in srgb, var(--catColor, var(--lightblue)) 55%, white));transition:width .5s cubic-bezier(.22,1,.36,1);}
  /* ---- ردیف هر تسک: تبدیل به چیپ کارتی ---- */
  .task-row{
    display:flex;align-items:center;gap:8px;padding:8px 10px;margin-bottom:0;
    background:rgba(255,255,255,0.035);border:1px solid var(--line);border-radius:9px;
    transition:border-color .2s, background .2s, transform .15s;min-width:0;
  }
  .task-row:hover{border-color:var(--catColor, var(--lightblue));background:rgba(255,255,255,0.06);transform:translateY(-1px);}
  .task-row input[type=text]{min-width:0;flex:1;background:none !important;border:none !important;padding:2px 0 !important;font-size:13px;}
  .task-row input[type=number]{
    width:50px;text-align:center;background:rgba(255,255,255,.05) !important;
    border:1px solid var(--line) !important;border-radius:6px;color:var(--catColor, var(--lightblue)) !important;font-weight:800 !important;padding:5px 2px !important;
  }
  input[type=text],input[type=number],input[type=date],input[type=email],input[type=tel],input[type=password],textarea,select{
    background:var(--navy-alt);border:1px solid var(--line);color:var(--white);border-radius:6px;padding:9px 10px;font-family:inherit;font-size:13px;
  }
  input:focus,textarea:focus,select:focus{outline:1.5px solid var(--lightblue);}
  select{
    background:linear-gradient(160deg, rgba(255,255,255,0.07), rgba(255,255,255,0.02)) !important;
    border:1px solid rgba(111,168,220,0.35) !important;
    backdrop-filter:blur(16px) saturate(180%);-webkit-backdrop-filter:blur(16px) saturate(180%);
    box-shadow:inset 0 1.5px 0 rgba(255,255,255,.10);
    -webkit-appearance:none;appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239AA3B2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>");
    background-repeat:no-repeat;background-position:left 10px center;background-size:14px;
    padding-left:30px;
  }
  select option{background:var(--navy);color:var(--white);}
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus{
    -webkit-box-shadow: 0 0 0 1000px var(--navy-alt) inset !important;
    -webkit-text-fill-color: var(--white) !important;
    caret-color: var(--white);
    transition: background-color 9999s ease-in-out 0s;
  }
  .icon-btn{background:none;border:1px solid var(--line);color:var(--white-dim);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;}
  .icon-row{display:flex;gap:5px;align-items:center;}
  .icon-btn:hover{border-color:var(--lightblue);color:var(--lightblue);}
  .add-task-btn{
    margin-top:12px;background:rgba(111,168,220,.05);border:1.5px dashed rgba(111,168,220,.4);color:var(--lightblue);
    border-radius:9px;padding:10px;width:100%;cursor:pointer;font-family:inherit;font-size:12.5px;font-weight:700;transition:.2s;
  }
  .add-task-btn:hover{border-color:var(--lightblue);background:rgba(111,168,220,.12);box-shadow:0 0 14px rgba(111,168,220,.2);}
  .btn{background:rgba(255,255,255,0.12);color:var(--white);border:1px solid rgba(255,255,255,0.2);border-radius:7px;padding:10px 18px;font-family:inherit;font-weight:700;font-size:13px;cursor:pointer;transition:.15s;}
  .btn:hover{background:rgba(255,255,255,0.2);border-color:rgba(255,255,255,0.32);}
  .btn:disabled{opacity:.5;cursor:not-allowed;}
  .btn.ghost{background:none;border:1px solid var(--line);color:var(--white);}
  .btn.ghost:hover{border-color:var(--lightblue);color:var(--lightblue);}
  .btn.small{padding:7px 12px;font-size:12px;}
  .today-header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;}
  .weekday-pill{font-size:11px;padding:5px 12px;border-radius:20px;background:linear-gradient(135deg, rgba(111,168,220,.18), rgba(111,168,220,.05));color:var(--lightblue);font-weight:700;border:1px solid rgba(111,168,220,.3);}

