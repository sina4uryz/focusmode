  async function paintMemberMedals(code, preloadedList){
    const wrap = document.getElementById('ctrlMedalsList');
    if(!wrap) return;
    const list = preloadedList || await loadAchievements(code);
    if(!list.length){ wrap.innerHTML = '<div class="empty">مدالی نداره</div>'; return; }
    wrap.innerHTML = list.map(a=>`
      <div class="del-row" style="padding:6px 0;">
        <div>${escapeHtml(a.name)} <span class="cd">${a.date?iranJalaliDate(a.date):''}</span></div>
        <button class="icon-btn-sm" data-revoke-medal="${a.id}" title="پس گرفتن مدال">✕</button>
      </div>
    `).join('');
    wrap.querySelectorAll('[data-revoke-medal]').forEach(b=>{
      b.addEventListener('click', guard_(async ()=>{
        const list2 = await loadAchievements(code);
        const filtered = list2.filter(a=>a.id!==b.dataset.revokeMedal);
        await saveAchievements(code, filtered);
        showToast('مدال پس گرفته شد');
        paintMemberMedals(code, filtered); // به‌جای یه بار دیگه خوندن از دیتابیس (که تاخیر اضافه می‌کرد)، همون لیستِ تازه رو مستقیم نشون می‌دیم
      }));
    });
  }
  pick.addEventListener('change', paintMemberBox);
  if(members.length) paintMemberBox();
}
function guard_(fn){ return async (...a)=>{ try{ await fn(...a); }catch(e){ console.error(e); showToast(t('errorToast')); } }; }

