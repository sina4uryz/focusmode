(function(){
  const containerIds = ['mainApp','mentorHome','adminApp'];
  function syncFloatingButtons(){
    const themeBtn = document.getElementById('themeToggle');
    const langBtn = document.getElementById('langToggle');
    const inPanel = containerIds.some(id=>{
      const elx = document.getElementById(id);
      return elx && !elx.classList.contains('hidden');
    });
    if(themeBtn) themeBtn.style.display = inPanel ? 'none' : '';
    if(langBtn) langBtn.style.display = inPanel ? 'none' : '';
    if(inPanel){ const lm = document.getElementById('langMenu'); if(lm) lm.classList.add('hidden'); }
  }
  containerIds.forEach(id=>{
    const elx = document.getElementById(id);
    if(elx) new MutationObserver(syncFloatingButtons).observe(elx, {attributes:true, attributeFilter:['class']});
  });
  syncFloatingButtons();
})();
