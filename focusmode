// مرحله‌ی آماده‌سازی Auth واقعی: بعد از لاگین موفق با کد، بی‌سروصدا یه نشست واقعی Supabase Auth می‌سازه.
// عمداً "fail-safe" نوشته شده — اگه هر بخشش شکست بخوره، به ورود عادیِ کاربر هیچ آسیبی نمی‌رسونه.
async function linkAuthSession(code, role, isRetry){
  try{
    const res = await fetch(SUPABASE_URL + '/functions/v1/code-login', {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'Authorization':'Bearer '+SUPABASE_ANON_KEY },
      body: JSON.stringify({ code, role })
    });
    if(!res.ok){ throw new Error('server responded '+res.status); }
    const data = await res.json();
    if(!data || !data.token_hash){ throw new Error('no token_hash in response'); }
    const { error: otpErr } = await sb.auth.verifyOtp({ token_hash: data.token_hash, type:'magiclink' });
    if(otpErr) throw otpErr;
    // چک نهاییِ نشست رو دیگه معطلِ ورود نمی‌کنیم — verifyOtp بدون خطا خودش یعنی نشست برقرار شده؛
    // این فقط یه اطمینانِ اضافه‌ست که تو پس‌زمینه انجام میشه، بدون این‌که کاربر منتظرش بمونه
    sb.auth.getSession().then(({data:sessionData})=>{
      if(!sessionData || !sessionData.session) console.error('session not established after verifyOtp (background check)', role, code);
    });
    console.log('auth session linked for', role, code);
    return true;
  }catch(e){
    console.error('linkAuthSession failed', e);
    if(!isRetry){
      await new Promise(r=>setTimeout(r, 500));
      return linkAuthSession(code, role, true); // یه بار دیگه امتحان کن، شاید یه خطای موقت شبکه بوده
    }
    return false;
  }
}
