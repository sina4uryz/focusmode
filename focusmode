window.storage = {
  async get(key){
    if(!cloudReady) return localGet(key);
    try{
      const { data, error } = await withTimeout(sb.from(TABLE).select('value').eq('key', key).maybeSingle(), 10000);
      if(error) throw error;
      if(!data){
        // ممکنه قبلاً به‌خاطر یه خطای موقت روی Supabase، این کلید فقط لوکال ذخیره شده باشه؛ چک می‌کنیم که چیزی گم نشه
        return localGet(key);
      }
      return { key, value: data.value, source:'cloud' };
    }catch(e){ console.error('supabase get failed → local fallback', e); return localGet(key); }
  },
  async set(key, value){
    if(!cloudReady) return localSet(key, value);
    try{
      const owner_code = extractOwnerCode(key);
      const { error } = await withTimeout(sb.from(TABLE).upsert({ key, value, owner_code, updated_at: new Date().toISOString() }, { onConflict: 'key' }), 10000);
      if(error) throw error;
      return { key, value, source:'cloud' };
    }catch(e){
      console.error('supabase set failed → local fallback', e);
      const r = localSet(key, value);
      r.source = 'local'; r.error = (e && e.message) ? e.message : String(e);
      return r;
    }
  },
  async delete(key){
    if(!cloudReady) return localDelete(key);
    try{
      const { error } = await withTimeout(sb.from(TABLE).delete().eq('key', key), 10000);
      if(error) throw error;
      return { key, deleted:true };
    }catch(e){ console.error('supabase delete failed → local fallback', e); return localDelete(key); }
  },
  async list(prefix){
    if(!cloudReady) return localList(prefix);
    try{
      const { data, error } = await withTimeout(sb.from(TABLE).select('key'), 10000);
      if(error) throw error;
      const keys = (data||[]).map(r=>r.key).filter(k=>!prefix || k.startsWith(prefix));
      return { keys };
    }catch(e){ console.error('supabase list failed → local fallback', e); return localList(prefix); }
  }
};

function showCloudBanner(ok){
  const el = document.getElementById('langToggle');
  const themeBtn = document.getElementById('themeToggle');
  [el, themeBtn].forEach(x=>{ if(x) x.classList.remove('cloud-ok','cloud-bad'); });
  if(ok){
    if(el) el.classList.add('cloud-ok');
    if(themeBtn) themeBtn.classList.add('cloud-ok');
    if(el) el.title = 'متصل به دیتابیس ابری — اطلاعات بین همه دستگاه‌ها مشترکه';
    if(themeBtn) themeBtn.title = 'متصل به دیتابیس ابری — اطلاعات بین همه دستگاه‌ها مشترکه';
  }else{
    if(el) el.classList.add('cloud-bad');
