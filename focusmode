  }
}

async function initStorageBackend(){
  const notConfigured = SUPABASE_URL.includes('PASTE_YOUR') || SUPABASE_ANON_KEY.includes('PASTE_YOUR');
  if(notConfigured){ cloudReady = false; showCloudBanner(false); return; }
  const libOk = await ensureSupabaseLib();
  if(!libOk){ cloudReady = false; showCloudBanner(false); return; } // نت اجازه نداد لایبرری لود بشه؛ محلی کار می‌کنیم
  try{
    sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const pingPromise = sb.from(TABLE).upsert({ key:'__ping__', value: JSON.stringify({ok:true,t:Date.now()}), updated_at: new Date().toISOString() }, { onConflict: 'key' });
    const timeoutPromise = new Promise((_, reject) => setTimeout(()=>reject(new Error('ping-timeout')), 8000));
    const { error } = await Promise.race([pingPromise, timeoutPromise]);
    if(error) throw error;
    cloudReady = true;
    showCloudBanner(true);
  }catch(e){
    console.error('Supabase init failed → local fallback', e);
    cloudReady = false;
    showCloudBanner(false);
  }
}
