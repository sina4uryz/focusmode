function showToast(msg){
  const toastEl = document.getElementById('toast');
  toastEl.textContent = msg || t('savedToast');
  toastEl.classList.add('show');
  clearTimeout(showToast._h);
  const dur = (msg && msg.length > 25) ? 3200 : 1600;
  showToast._h = setTimeout(()=>toastEl.classList.remove('show'), dur);
}
// افکت شیشه‌ای موقع سوییچ بین تب‌ها (شبیه ترنزیشن آیفون) — فقط موقع تعویض تب، نه هر رندر داخلی
function glassSwitchIn(panelEl){
  if(!panelEl) return;
  panelEl.classList.remove('glass-anim');
  void panelEl.offsetWidth; // force reflow تا انیمیشن دوباره از اول اجرا شه
  panelEl.classList.add('glass-anim');
  panelEl.addEventListener('animationend', ()=>panelEl.classList.remove('glass-anim'), { once:true });
}
// simple guard to stop double-submits on a button while an async save is in flight
function guard(btn, fn){
  return async (...args)=>{
    if(btn.dataset.busy==='1') return;
    btn.dataset.busy='1'; btn.disabled=true;
    try{ await fn(...args); }
    catch(e){ console.error('guard caught error', e); showToast(t('errorToast')); }
    finally{ btn.dataset.busy='0'; btn.disabled=false; }
  };
}

