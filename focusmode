let activeChatRefreshers = [];
let currentStatusRefresh = null;
function clearLiveRefreshers(){ activeChatRefreshers = []; currentStatusRefresh = null; }
// یه پنل لیستی (قانون‌ها/اپدیت‌ها/مدال‌ها) رو به چرخه‌ی رفرش خودکار وصل می‌کنه — فقط وقتی محتوا واقعاً عوض شده دوباره رندر می‌کنه
async function registerLiveListRefresh(panelId, loadFn, renderFn, ...renderArgs){
  // اگه قبلاً یه رفرشر دقیقاً برای همین پنل+همین تابع رندر ثبت شده (مثلاً چون منتور/مدیر چندتا پروفایل رو پشت‌سرهم باز کرده)،
  // اون قدیمیه رو حذف کن — وگرنه هی روی هم تلنبار میشن و هر تیک، درخواست‌های تکراری به دیتابیس می‌زنن (باعث لگ می‌شد)
  activeChatRefreshers = activeChatRefreshers.filter(fn=>!(fn.__panelId===panelId && fn.__renderFnName===renderFn.name));
  let lastSnapshot;
  try{ lastSnapshot = JSON.stringify(await loadFn()); }catch(e){ lastSnapshot = null; }
  async function refresh(){
    const el = document.getElementById(panelId);
    if(!el || !document.body.contains(el)) return false;
    try{
      const snap = JSON.stringify(await loadFn());
      if(snap !== lastSnapshot){
        // اگه کاربر همین الان داره تو فرم این پنل تایپ می‌کنه، فعلاً رندر نکن که پاک نشه — تیک بعدی دوباره چک می‌کنیم
        if(el.contains(document.activeElement) && document.activeElement !== document.body){
          return true;
        }
        lastSnapshot = snap;
        await renderFn(panelId, ...renderArgs);
      }
    }catch(e){}
    return true;
  }
  refresh.__panelId = panelId;
  refresh.__renderFnName = renderFn.name;
  activeChatRefreshers.push(refresh);
}
setInterval(async ()=>{
  // قبلاً اینا یکی‌یکی و منتظرِ هم اجرا می‌شدن (for...await) — یعنی اگه ۱۰ تا پنل باز بود، هر تیک باید صبر می‌کرد
  // تا ۱۰ تا درخواست پشت‌سرهم به دیتابیس تموم شه؛ همینا رو سایت رو کند و هنگ‌کننده می‌کرد. الان همه‌شون هم‌زمانن.
  const list = activeChatRefreshers.slice();
  const results = await Promise.all(list.map(fn=>fn().catch(()=>true)));
  activeChatRefreshers = activeChatRefreshers.filter((fn,i)=>{
    const idx = list.indexOf(fn);
    return idx===-1 || results[idx]!==false;
  });
  if(currentStatusRefresh){ try{ await currentStatusRefresh(); }catch(e){} }
  if(currentCode && !isViewOnly) checkUpdatesBadge(currentCode, 'updatesBadgeMember');
  if(currentMentorCode) checkUpdatesBadge(currentMentorCode, 'updatesBadgeMentor');
}, 1800);

