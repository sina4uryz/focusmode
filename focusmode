      if(w.revealed){
        h+=`<div class="week-row">
          <div class="week-row-head">
            <span class="week-row-title">هفته ${w.index}</span>
            <span class="week-row-score">${Math.round(w.score*10)/10} امتیاز</span>
            <span class="stamp ${w.cls}">${w.label} · ${w.grade}</span>
          </div>
          <div class="week-days">${dayChips}</div>
        </div>`;
      }else if(w.index===cycle.currentWeekIndex){
        h+=`<div class="week-row">
          <div class="week-row-head">
            <span class="week-row-title">هفته ${w.index}</span>
            <span class="week-row-pending">در حال ثبت — پنجشنبه ساعت ۱۲:۱۰ بامداد اعلام میشه</span>
          </div>
          <div class="week-days">${dayChips}</div>
        </div>`;
      }
    });
    wWrap.innerHTML = h;
  }
  const mWrap = document.getElementById('monthlyTable');
