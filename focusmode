// یه کارت چت دوطرفه بین «myRole» (کسی که پشت این نمایشه) و طرف مقابل، رو یه ترد مشخص (thread_admin یا thread_mentor)
async function renderChatCard(containerEl, memberCode, threadKey, myRole, title, senderLabelFn){
  const wrapId = ('chatwrap_'+threadKey+'_'+memberCode+'_'+myRole).replace(/[^a-zA-Z0-9_-]/g, '_');
  const card = document.createElement('div');
  card.className = 'card';
  card.innerHTML = `${title?`<h2>${title}</h2>`:''}<div class="typing-indicator hidden" id="${wrapId}_typing"><span class="typing-dots"><span></span><span></span><span></span></span> در حال نوشتن...</div><div class="chat-log" id="${wrapId}_log"></div>
    <div class="row-flex" style="margin-top:10px;">
      <input type="text" id="${wrapId}_input" placeholder="پیامتو بنویس...">
      <button class="btn small" id="${wrapId}_btn">ارسال</button>
    </div>`;
  containerEl.appendChild(card);
  const logEl = card.querySelector('#'+wrapId+'_log');
  const typingEl = card.querySelector('#'+wrapId+'_typing');
  const inputEl = card.querySelector('#'+wrapId+'_input');
  const otherRole = threadKey.startsWith('thread_mentor_admin') ? (myRole==='mentor'?'admin':'mentor')
    : threadKey.startsWith('thread_mentor:') ? (myRole==='member'?'mentor':'member')
    : (myRole==='member'?'admin':'member'); // thread_admin
  inputEl.addEventListener('input', ()=>setTyping(threadKey+':'+memberCode, myRole));

  let lastList = [];
  let sending = false;
  function renderList(list){
    lastList = list;
    const nearBottom = logEl.scrollHeight - logEl.scrollTop - logEl.clientHeight < 40;
    if(list.length===0){ logEl.innerHTML = '<div class="empty">هنوز پیامی نیست — همینجا می‌تونی شروع کنی</div>'; return; }
    let html = '';
    list.forEach(m=>{
      const mine = m.from===myRole;
      const canDel = mine || myRole==='admin';
      html += `<div class="chat-bubble ${mine?'mine':'theirs'}"><div class="chat-sender">${escapeHtml(senderLabelFn(m.from))} ${canDel?`<button class="icon-btn-sm" data-del-msg="${m.id}" title="حذف">✕</button>`:''}</div><div>${escapeHtml(m.text)}</div><div class="chat-time">${iranJalaliShort(m.date)}${m.time?` · ${m.time}`:''}</div></div>`;
    });
    logEl.innerHTML = html;
    if(nearBottom) logEl.scrollTop = logEl.scrollHeight;
    logEl.querySelectorAll('[data-del-msg]').forEach(delBtn=>delBtn.addEventListener('click', guard(delBtn, async ()=>{
      const fresh = await loadThread(memberCode, threadKey);
      const filtered = fresh.filter(m=>m.id!==delBtn.dataset.delMsg);
      await saveThread(memberCode, threadKey, filtered);
      await refreshLog();
    })));
  }
  async function refreshLog(){
    if(!document.body.contains(logEl)) return false; // دیگه رو صفحه نیست، از رفرش‌های بعدی حذف شه
    if(sending) return true; // یه پیام همین الان داره ارسال میشه، فعلاً رفرش نکن که پیام محو نشه
    const list = await loadThread(memberCode, threadKey);
    renderList(list);
    isTyping(threadKey+':'+memberCode, otherRole).then(t=>typingEl.classList.toggle('hidden', !t));
    return true;
  }
  await refreshLog();
  logEl.scrollTop = logEl.scrollHeight;
  activeChatRefreshers.push(refreshLog);

  const btn = card.querySelector('#'+wrapId+'_btn');
  btn.addEventListener('click', guard(btn, async ()=>{
    const input = card.querySelector('#'+wrapId+'_input');
    const val = input.value.trim();
    if(!val) return;
    input.value='';
    const newMsg = {id:uid(), from:myRole, text:val, date:new Date().toISOString().slice(0,10), time:iranNowTime()};
    renderList([...lastList, newMsg]); // نمایش فوری بدون معطلی، ذخیره‌سازی پشت‌صحنه انجام میشه
    sending = true;
    const fresh = await loadThread(memberCode, threadKey); // آخرین نسخه رو می‌گیریم که پیام کس دیگه‌ای که هم‌زمان فرستاده گم نشه
    fresh.push(newMsg);
    await saveThread(memberCode, threadKey, fresh);
    lastList = fresh;
    sending = false;
  }));
}

// یه رنگ ثابت و مخصوص به هر کد/اسم می‌سازه (همیشه یه رنگ برای یه نفر، بدون نیاز به عکس یا دیتابیس)
function hashColor(str){
  let h = 0;
  for(let i=0;i<str.length;i++){ h = str.charCodeAt(i) + ((h<<5)-h); }
  return `hsl(${Math.abs(h)%360}, 62%, 58%)`;
}
// یه UI مثل پیام‌رسان: لیست مخاطب‌ها، کلیک روی هرکدوم چت خصوصیِ همون‌ آدم رو با یه ترنزیشن قشنگ باز می‌کنه
async function renderContactChatPicker(el, contacts, openChat){
  // contacts: [{ key, name, sub }]  — openChat(chatWrap, contact) باید چت رو رندر کنه
  el.innerHTML = '';
  const listWrap = document.createElement('div');
  listWrap.className = 'card';
  listWrap.innerHTML = `<h2>${icon('chat')} مخاطبین</h2><div id="contactList"></div>`;
  el.appendChild(listWrap);
  const chatWrap = document.createElement('div');
  chatWrap.className = 'chat-pv-wrap';
  el.appendChild(chatWrap);
  const listEl = listWrap.querySelector('#contactList');
  if(contacts.length===0){ listEl.innerHTML = '<div class="empty">کسی نیست</div>'; return; }
  // قبلاً اینجا برای هر مخاطب یه درخواست جدا به دیتابیس می‌رفت که عکس پروفایلش رو بگیره (که اصلاً هیچ‌وقت عکسی هم آپلود نمی‌شد) — حذفش کردیم؛ به‌جاش یه نشان رنگیِ ثابت با حرف اول اسم، بدون هیچ درخواست اضافه‌ای
  const onlineFlags = await Promise.all(contacts.map(c=>isOnline(c.key)));
  listEl.innerHTML = contacts.map((c,i)=>`
    <div class="del-row contact-row" data-key="${c.key}" style="cursor:pointer;">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="contact-avatar" style="--tagc:${hashColor(c.key)};">${escapeHtml((c.name||'?').trim()[0]||'?')}${onlineFlags[i]?'<span class="contact-online-dot"></span>':''}</div>
        <div><b>${escapeHtml(c.name)}</b><div class="cd">${onlineFlags[i]?'آنلاین':(c.sub?escapeHtml(c.sub):'آفلاین')}</div></div>
      </div>
      <span style="color:var(--white-dim);font-size:16px;">‹</span>
    </div>`).join('');
  listEl.querySelectorAll('.contact-row').forEach(row=>{
    row.addEventListener('click', async ()=>{
      const c = contacts.find(x=>x.key===row.dataset.key);
      listEl.querySelectorAll('.contact-row').forEach(r=>r.classList.remove('active-contact'));
      row.classList.add('active-contact');
      await openChat(chatWrap, c);
      glassSwitchIn(chatWrap);
      if(window.innerWidth < 700) chatWrap.scrollIntoView({behavior:'smooth', block:'start'});
    });
  });
  // اولین مخاطب رو خودکار باز می‌کنیم که خالی نمونه
  listEl.querySelector('.contact-row')?.click();
}

// تب پیام‌های یه کاربر خاص — بسته به اینکه چه کسی داره نگاه می‌کنه (خود کاربر/منتور/رئیس) نمای مناسب رو می‌سازه
async function renderMessagesTab(panelId, memberCode, viewerRole){
  const el = document.getElementById(panelId);
  if(!el) return;
  el.innerHTML = '';
  const adminLabel = f => f==='admin' ? 'مدیریت' : 'من';
  if(viewerRole==='member'){
    const mentors = (await loadMentorRegistry()).filter(m=>!m.deleted);
    const registryAll = await loadMemberRegistry();
    const myRec = registryAll.find(m=>m.code===memberCode);
    const assignedMentor = myRec && myRec.mentorCode ? mentors.find(m=>m.code===myRec.mentorCode) : null;
    const mentorContacts = assignedMentor ? [assignedMentor] : mentors; // اگه رئیس منتور مشخصی رو تعیین کرده باشه، فقط همون یکی نشون داده میشه
    const contacts = [
      { key:'admin', name:'مدیریت', sub:'ارتباط با مدیریت دوره' },
      ...mentorContacts.map(m=>({ key:m.code, name:m.name, sub:'منتور شما' }))
    ];
    await renderContactChatPicker(el, contacts, async (chatWrap, c)=>{
      chatWrap.innerHTML = '';
      if(c.key==='admin'){
        await renderChatCard(chatWrap, memberCode, 'thread_admin', 'member', icon('chat')+' چت با مدیریت', adminLabel);
      }else{
        await renderChatCard(chatWrap, memberCode, 'thread_mentor:'+c.key, 'member', `${icon('chat')} چت با ${escapeHtml(c.name)}`, f=>f==='mentor'?c.name:'من');
      }
    });
  }else if(viewerRole==='admin'){
    await renderChatCard(el, memberCode, 'thread_admin', 'admin', icon('chat')+' چت با این کاربر', f=>f==='admin'?'من':'کاربر');
  }else if(viewerRole==='mentor'){
    await renderChatCard(el, memberCode, 'thread_mentor:'+currentMentorCode, 'mentor', icon('chat')+' چت با این کاربر', f=>f==='mentor'?'من':'کاربر');
  }
}

async function renderMentorAdminChatPanel(panelId, mentorCode, viewerRole){
