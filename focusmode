// ================= Personal Notes: Journal + Monthly Goal — کاربر می‌نویسه، منتور/رئیس می‌بینن =================
async function loadJournal(code){
  try{ const r = await window.storage.get('journal:'+code, true); return r && r.value ? JSON.parse(r.value) : []; }
  catch(e){ return []; }
}
async function saveJournal(code, list){
  try{ await window.storage.set('journal:'+code, JSON.stringify(list), true); }catch(e){ console.error(e); }
}
async function loadNotebook(code){
  try{ const r = await window.storage.get('notebook:'+code, true); return r && r.value ? JSON.parse(r.value) : []; }
  catch(e){ return []; }
}
async function saveNotebook(code, list){
  try{ await window.storage.set('notebook:'+code, JSON.stringify(list), true); }catch(e){ console.error(e); }
}
async function loadMonthlyGoal(code){
  try{ const r = await window.storage.get('monthlygoal:'+code, true); return r && r.value ? JSON.parse(r.value) : null; }
  catch(e){ return null; }
}
async function saveMonthlyGoal(code, obj){
  try{
    const r = await window.storage.set('monthlygoal:'+code, JSON.stringify(obj), true);
    if(r && r.source==='local'){ return { ok:false, err: r.error || 'اتصال به دیتابیس مشترک برقرار نشد' }; }
    return { ok:true };
  }catch(e){ console.error(e); return { ok:false, err: (e&&e.message)||String(e) }; }
}
async function renderPersonalNotesPanel(panelId, code, viewOnly, notebookHidden){
  const el = document.getElementById(panelId);
  if(!el) return;
  const goal = await loadMonthlyGoal(code);
  let journal = await loadJournal(code);
  let notebook = notebookHidden ? [] : await loadNotebook(code);

  let html = `<div class="card notes-card"><h2>${icon('target')} Monthly Goal</h2>`;
  if(viewOnly){
    if(goal){
      html += `<div class="fb-line"><b>هدف:</b> ${escapeHtml(goal.goal||'')}</div>
        <div class="fb-line"><b>تا کی:</b> ${escapeHtml(goal.deadline||'')}</div>
        <div class="fb-line"><b>دلیل:</b> ${escapeHtml(goal.reason||'')}</div>
        <div class="meta">آخرین ثبت: ${goal.date?iranJalaliDate(goal.date):''}${goal.time?` · ساعت ${goal.time}`:''}</div>`;
    }else{ html += '<div class="empty">هنوز هدفی ثبت نشده</div>'; }
  }else{
    html += `<label class="field-label">هدف ماه من چیه؟</label>
      <textarea id="goalText_${panelId}">${escapeHtml(goal?.goal||'')}</textarea>
      <label class="field-label" style="margin-top:8px;">تا کی می‌خوام بهش برسم؟</label>
      <input type="text" id="goalDeadline_${panelId}" value="${escapeHtml(goal?.deadline||'')}" placeholder="مثلاً پایان ماه">
      <label class="field-label" style="margin-top:8px;">دلیل رسیدن بهش چیه؟</label>
      <textarea id="goalReason_${panelId}">${escapeHtml(goal?.reason||'')}</textarea>
      <div style="margin-top:10px;"><button class="btn small" id="goalBtn_${panelId}">ثبت هدف ماه</button></div>`;
  }
  html += '</div>';

  html += `<div class="card notes-card"><h2>${icon('book')} Journal</h2>`;
  if(!viewOnly){
    html += `<textarea id="journalText_${panelId}" placeholder="امروز چی گذشت؟..."></textarea>
      <div style="margin-top:10px;"><button class="btn small" id="journalBtn_${panelId}">ثبت ژورنال</button></div>`;
  }
  html += '<div id="journalList_'+panelId+'" style="margin-top:12px;"></div></div>';

  html += `<div class="card notes-card"><h2>${icon('note')} دفتر یادداشت</h2>`;
  if(notebookHidden){
    html += '<div class="empty">این بخش برای منتورها مخفیه</div></div>';
  }else{
    if(!viewOnly){
      html += `<textarea id="notebookText_${panelId}" placeholder="یه یادداشت آزاد بنویس..."></textarea>
        <div style="margin-top:10px;"><button class="btn small" id="notebookBtn_${panelId}">ثبت یادداشت</button></div>`;
    }
    html += '<div id="notebookList_'+panelId+'" style="margin-top:12px;"></div></div>';
  }
  el.innerHTML = html;

  const jWrap = el.querySelector('#journalList_'+panelId);
  let lastJId = null;
  function paintJournal(){
    if(journal.length===0){ jWrap.innerHTML = '<div class="empty">هنوز ژورنالی ثبت نشده</div>'; return; }
    let jHtml = '';
    journal.slice().reverse().forEach(j=>{
      jHtml += `<div class="fb-entry${j.id===lastJId?' entry-pop':''}" data-entry-id="${j.id}"><div class="cyc">${iranJalaliDate(j.date)}${j.time?` · ساعت ${j.time}`:''} ${(!viewOnly)?`<button class="icon-btn" style="float:left;" data-del-j="${j.id}" title="حذف">✕</button>`:''}</div><div class="fb-line">${escapeHtml(j.text)}</div></div>`;
    });
    jWrap.innerHTML = jHtml;
    jWrap.querySelectorAll('[data-del-j]').forEach(btn=>btn.addEventListener('click', guard(btn, async ()=>{
      journal = journal.filter(j=>j.id!==btn.dataset.delJ);
      paintJournal(); // حذف فوری از صفحه
      const fresh = await loadJournal(code);
      await saveJournal(code, fresh.filter(j=>j.id!==btn.dataset.delJ));
    })));
    if(lastJId){
      const freshEl = jWrap.querySelector(`[data-entry-id="${lastJId}"]`);
      if(freshEl) freshEl.scrollIntoView({behavior:'smooth', block:'center'});
    }
  }
  paintJournal();

  const nWrap = el.querySelector('#notebookList_'+panelId);
  let lastNId = null;
  function paintNotebook(){
    if(!nWrap) return;
    if(notebook.length===0){ nWrap.innerHTML = '<div class="empty">هنوز یادداشتی ثبت نشده</div>'; return; }
    let nHtml = '';
    notebook.slice().reverse().forEach(n=>{
      nHtml += `<div class="fb-entry${n.id===lastNId?' entry-pop':''}" data-entry-id="${n.id}"><div class="cyc">${iranJalaliDate(n.date)}${n.time?` · ساعت ${n.time}`:''} ${(!viewOnly)?`<button class="icon-btn" style="float:left;" data-del-n="${n.id}" title="حذف">✕</button>`:''}</div><div class="fb-line">${escapeHtml(n.text)}</div></div>`;
    });
    nWrap.innerHTML = nHtml;
    nWrap.querySelectorAll('[data-del-n]').forEach(btn=>btn.addEventListener('click', guard(btn, async ()=>{
      notebook = notebook.filter(n=>n.id!==btn.dataset.delN);
      paintNotebook();
      const fresh = await loadNotebook(code);
      await saveNotebook(code, fresh.filter(n=>n.id!==btn.dataset.delN));
    })));
    if(lastNId){
      const freshEl = nWrap.querySelector(`[data-entry-id="${lastNId}"]`);
      if(freshEl) freshEl.scrollIntoView({behavior:'smooth', block:'center'});
    }
  }
  if(!notebookHidden) paintNotebook();

  if(!viewOnly){
    const goalBtn = el.querySelector('#goalBtn_'+panelId);
    goalBtn.addEventListener('click', guard(goalBtn, async ()=>{
      const goalTa = el.querySelector('#goalText_'+panelId);
      const deadlineInp = el.querySelector('#goalDeadline_'+panelId);
      const reasonTa = el.querySelector('#goalReason_'+panelId);
      if(!goalTa || !deadlineInp || !reasonTa){
        showToast('خطا — فرم پیدا نشد، صفحه رو دوباره باز کن');
        return;
      }
      const obj = {
        goal: goalTa.value.trim(),
        deadline: deadlineInp.value.trim(),
        reason: reasonTa.value.trim(),
        date: new Date().toISOString().slice(0,10),
        time: iranNowTime()
      };
      const res = await saveMonthlyGoal(code, obj);
      if(res.ok){
        showToast('هدف ماه ثبت شد');
        await renderPersonalNotesPanel(panelId, code, viewOnly, notebookHidden);
      }else{
        showToast('ثبت نشد: ' + res.err);
      }
    }));
    const jBtn = el.querySelector('#journalBtn_'+panelId);
    jBtn.addEventListener('click', guard(jBtn, async ()=>{
      const ta = el.querySelector('#journalText_'+panelId);
      const val = ta.value.trim();
      if(!val) return;
      ta.value='';
      const newEntry = {id:uid(), text:val, date:new Date().toISOString().slice(0,10), time:iranNowTime()};
      journal.push(newEntry);
      lastJId = newEntry.id;
      paintJournal(); // نمایش فوری، بدون معطلی
      const fresh = await loadJournal(code); // آخرین نسخه رو می‌گیریم که چیزی گم نشه
      fresh.push(newEntry);
      await saveJournal(code, fresh);
      journal = fresh;
    }));
    if(!notebookHidden){
      const nBtn = el.querySelector('#notebookBtn_'+panelId);
      nBtn.addEventListener('click', guard(nBtn, async ()=>{
        const ta = el.querySelector('#notebookText_'+panelId);
        const val = ta.value.trim();
        if(!val) return;
        ta.value='';
        const newEntry = {id:uid(), text:val, date:new Date().toISOString().slice(0,10), time:iranNowTime()};
        notebook.push(newEntry);
        lastNId = newEntry.id;
        paintNotebook();
        const fresh = await loadNotebook(code);
        fresh.push(newEntry);
        await saveNotebook(code, fresh);
        notebook = fresh;
      }));
    }
  }
}

