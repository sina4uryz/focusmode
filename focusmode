        showToast('پروژه حذف شد');
        paint();
      }));
    }
    const addBtn = document.getElementById('plannerAddBtn');
    addBtn.addEventListener('click', guard(addBtn, async ()=>{
      const p = newPlannerProject('پروژه '+(list.length+1));
      list.push(p);
      await savePlannerData(code, list);
      activeId = p.id;
      showToast('پروژه جدید ساخته شد');
      paint();
    }));
    wireEditor();
  }

  function wireEditor(){
    const wrap = document.getElementById('plannerEditorWrap');
    if(!wrap) return;
    wrap.querySelectorAll('[data-pf]').forEach(f=>{
      f.addEventListener('blur', guard_(async ()=>{
        const proj = list.find(p=>p.id===activeId);
        if(!proj) return;
        proj[f.dataset.pf] = f.value;
        await savePlannerData(code, list);
      }));
    });
    // هشت‌تا گرید جداست (هر کدوم قسمت ۱ تا ۱۰۰ خودشو داره)، رو همه‌شون یه شنوندهٔ کلیک با تفویض می‌ذاریم
    wrap.querySelectorAll('[data-sqgrid]').forEach(grid=>{
      grid.addEventListener('click', (e)=>{
        const cell = e.target.closest('[data-sq]');
        if(!cell) return;
        const b = cell.dataset.box, n = cell.dataset.sq;
        const key = `b${b}-${n}`;
        const proj = list.find(p=>p.id===activeId);
        if(!proj) return;
        const set = new Set(proj.done||[]);
        if(set.has(key)) set.delete(key); else set.add(key);
        proj.done = [...set];
        // اول خودِ صفحه فوری آپدیت میشه، بعد تو پس‌زمینه ذخیره میشه — دیگه منتظر شبکه نمی‌مونه
        cell.classList.toggle('done');
        const boxDoneCount = [...set].filter(k=>k.startsWith(`b${b}-`)).length;
        const prog = wrap.querySelector(`[data-boxprogress="${b}"]`);
        if(prog) prog.textContent = `${boxDoneCount} از ۱۰۰ کامل شده`;
        savePlannerData(code, list);
      });
    });
  }

  paint();
}

// ---- بوم امضا (Signature Pad) ----
function setupSignaturePad(canvas){
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#F4F6F9'; ctx.fillRect(0,0,canvas.width,canvas.height); // زمینه‌ی ثابت روشن، مستقل از تم، تا امضا همیشه خونا بمونه
  ctx.strokeStyle = '#12172A'; // جوهر تیره‌ی ثابت (پیش‌فرض: مشکی)
  ctx.lineWidth = 5.6; ctx.lineJoin='round'; ctx.lineCap='round';
  let drawing = false, hasDrawn = false, lastPoint = null;
  function pos(e){
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width, scaleY = canvas.height / rect.height;
    const cx = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
    const cy = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
    return { x: cx*scaleX, y: cy*scaleY };
  }
  function start(e){ e.preventDefault(); drawing = true; const p = pos(e); lastPoint = p; ctx.beginPath(); ctx.moveTo(p.x, p.y); }
  function move(e){
    if(!drawing) return; e.preventDefault();
    const p = pos(e);
    const mid = { x:(lastPoint.x+p.x)/2, y:(lastPoint.y+p.y)/2 };
    ctx.quadraticCurveTo(lastPoint.x, lastPoint.y, mid.x, mid.y);
    ctx.stroke();
    lastPoint = p;
    hasDrawn = true;
  }
  function end(){ drawing = false; lastPoint = null; }
  canvas.addEventListener('mousedown', start);
  canvas.addEventListener('mousemove', move);
  window.addEventListener('mouseup', end);
  canvas.addEventListener('touchstart', start, {passive:false});
  canvas.addEventListener('touchmove', move, {passive:false});
  canvas.addEventListener('touchend', end);
  return {
    clear(){ ctx.clearRect(0,0,canvas.width,canvas.height); ctx.fillStyle='#F4F6F9'; ctx.fillRect(0,0,canvas.width,canvas.height); hasDrawn = false; },
    isEmpty(){ return !hasDrawn; },
    dataURL(){ return canvas.toDataURL('image/png'); },
    setColor(c){ ctx.strokeStyle = c; }
  };
}
