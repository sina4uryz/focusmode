    </div></td></tr>`;
  }

  function buildAndPaint(monthHistory, cycleStartNow){
    const usedDates = new Set();
    const groups = [];
    monthHistory.forEach(m=>{
      const weeks = (m.weeks||[]).map(w=>({ index:w.index, dates:(w.dates||[]).filter(d=>dailyRecords[d]) })).filter(w=>w.dates.length);
      weeks.forEach(w=>w.dates.forEach(d=>usedDates.add(d)));
      if(weeks.length) groups.push({ label:`ماه ${m.index}`, weeks });
    });
    if(cycleStartNow){
      const info = computeCycle(cycleStartNow);
      if(info){
        const weeks = info.weeks.map(w=>({ index:w.index, dates:w.dates.filter(d=>dailyRecords[d]) })).filter(w=>w.dates.length);
        if(weeks.length){
          weeks.forEach(w=>w.dates.forEach(d=>usedDates.add(d)));
          groups.push({ label:`ماه ${monthHistory.length+1} (در حال انجام)`, weeks });
        }
      }
    }
    const leftover = dates.filter(d=>!usedDates.has(d));
    if(leftover.length) groups.push({ label:'سایر روزها (تفریحی / خارج از دوره)', weeks:[{ index:null, dates:leftover }] });

    let html = '';
    groups.slice().reverse().forEach((g, gi)=>{
      let inner = '<table><tr><th>تاریخ</th><th>روز</th><th>امتیاز روزانه</th><th></th></tr>';
      g.weeks.forEach((w, wi)=>{
        if(wi>0) inner += '<tr class="week-sep-row"><td colspan="4"><div class="week-sep-line"></div></td></tr>';
        w.dates.slice().sort().reverse().forEach(d=>{ inner += rowHtml(d); });
      });
      inner += '</table>';
      html += `<details class="history-group"${gi===0?' open':''}>
        <summary class="history-group-summary"><span>${g.label}</span><span class="history-group-count">${g.weeks.reduce((s,w)=>s+w.dates.length,0)} روز</span></summary>
        <div class="history-group-body">${inner}</div>
      </details>`;
    });
    wrap.innerHTML = html;

    wrap.querySelectorAll('[data-del-day]').forEach(btn=>btn.addEventListener('click', ()=>{ delete dailyRecords[btn.dataset.delDay]; saveDaily(); updateHeaderStats(); renderToday(); }));
    wrap.querySelectorAll('[data-view-day]').forEach(btn=>btn.addEventListener('click', ()=>{
      const d = btn.dataset.viewDay;
      const rec = dailyRecords[d];
      const card = document.getElementById('dayDetailCard') || document.getElementById('dayDetailCardVO');
      if(!card) return;
      card.classList.remove('hidden');
      let html2 = `<h2>جزئیات روز ${iranJalaliDate(d)} (${rec.weekday||''}) — فقط نمایش</h2>`;
      const dayCategories = categoriesForDay(rec.weekday);
      dayCategories.forEach((cat,idx)=>{
      html2 += `<div class="checklist-cat" style="--catColor:${catColor(idx)};"><div class="cat-title">${escapeHtml(cat.name)}</div>`;
      cat.tasks.forEach(task=>{
        const checked = rec.done && rec.done[task.id] ? 'checked' : '';
        html2 += `<div class="chk-row"><input type="checkbox" disabled ${checked}><label>${escapeHtml(task.name)}</label><span class="pts">${task.points}</span></div>`;
      });
      html2 += '</div>';
    });
    card.innerHTML = html2;
    card.scrollIntoView({behavior:'smooth', block:'nearest'});
  }));
  }

  // کش هر کد — تا وقتی renderToday() دوباره صدا زده میشه (مثلاً درست بعد از ثبت روز)، تاریخچه
  // فوری از رو کش قبلی نشون داده بشه (بدون خالی‌شدن لحظه‌ای) و هم‌زمان در پس‌زمینه آپدیت بشه.
  // این دقیقاً همون باگی رو حل می‌کنه که تاریخچه یهو غیب میشه و دوباره میاد.
  const cached = _recordedDaysCache[currentCode];
  if(cached) buildAndPaint(cached.monthHistory, cached.cycleStart);

  const [monthHistory, cycleStartNow] = await Promise.all([loadMonthHistory(currentCode), loadCycleStart(currentCode)]);
  _recordedDaysCache[currentCode] = { monthHistory, cycleStart:cycleStartNow };
  buildAndPaint(monthHistory, cycleStartNow);
}


// ================= robust native chart fallback =================
// If Chart.js cannot be downloaded (blocked CDN/offline), draw the same daily chart
// directly on canvas so the dashboard never shows a blank chart.
function renderNativeDailyChart(canvas, labels, data, mode){
  mode = mode || 'duo';
  if(!canvas) return;
  const wrap = canvas.parentElement;
  if(!wrap) return;

  const draw = ()=>{
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    const rect = wrap.getBoundingClientRect();
    const w = Math.max(320, Math.floor(rect.width - 20));
    const h = Math.max(180, Math.floor(rect.height - 20));
    canvas.width = Math.floor(w * dpr);
    canvas.height = Math.floor(h * dpr);
    canvas.style.width = w + "px";
    canvas.style.height = h + "px";

    const ctx = canvas.getContext("2d");
    ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.clearRect(0,0,w,h);

    const isLight = document.body.classList.contains("light");
    const grid = isLight ? "#D2D9E2" : "#3A4152";
    const textColor = isLight ? "#5F6876" : "#9AA3B2";
    const navy = getComputedStyle(document.body).getPropertyValue("--navy-alt").trim() || (isLight ? "#EBEEF3" : "#232C40");

    ctx.fillStyle = navy;
    ctx.fillRect(0,0,w,h);

    const pad = {l:38,r:16,t:18,b:34};
    const pw = Math.max(1,w-pad.l-pad.r);
    const ph = Math.max(1,h-pad.t-pad.b);

    // Grid + Y labels
    ctx.font = '10px Vazirmatn, Tahoma, sans-serif';
    ctx.textAlign = "right";
    ctx.textBaseline = "middle";
    for(let v=0; v<=100; v+=10){
      const y = pad.t + ph - (v/100)*ph;
      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(pad.l,y); ctx.lineTo(w-pad.r,y); ctx.stroke();
      ctx.fillStyle = textColor;
      ctx.fillText(String(v), pad.l-7, y);
    }

    const n = data.length;
    if(!n) return;

    const xAt = i => n===1 ? pad.l+pw/2 : pad.l + (i/(n-1))*pw;
    const yAt = v => pad.t + ph - (Math.max(0,Math.min(100,Number(v)||0))/100)*ph;

    // Alternating week bands
    for(let start=0; start<n; start+=5){
      const end=Math.min(start+4,n-1);
      const x1=xAt(start)-(n>1 ? (xAt(1)-xAt(0))/2 : 20);
      const x2=xAt(end)+(n>1 ? (xAt(1)-xAt(0))/2 : 20);
      ctx.fillStyle = (Math.floor(start/5)%2===0)
        ? (isLight ? "rgba(62,111,168,.055)" : "rgba(111,168,220,.06)")
        : (isLight ? "rgba(30,40,60,.025)" : "rgba(233,234,236,.025)");
      ctx.fillRect(Math.max(pad.l,x1),pad.t,Math.min(w-pad.r,x2)-Math.max(pad.l,x1),ph);
    }

    // Area + segmented line
    for(let i=0;i<n-1;i++){
      const x1=xAt(i), y1=yAt(data[i]), x2=xAt(i+1), y2=yAt(data[i+1]);
      const up = Number(data[i+1]) > Number(data[i]);
      const down = Number(data[i+1]) < Number(data[i]);
      const line = mode==='mono' ? "#2E7CE6" : (up ? "#0F7B3D" : down ? "#A81616" : "#9AA3B2");

      const grad=ctx.createLinearGradient(0,pad.t,0,pad.t+ph);
      if(mode==='mono'){
        grad.addColorStop(0, "rgba(46,124,230,.30)");
      }else{
        grad.addColorStop(0, up ? "rgba(15,123,61,.22)" : down ? "rgba(168,22,22,.22)" : "rgba(154,163,178,.08)");
      }
      grad.addColorStop(1, "rgba(154,163,178,0.01)");

      ctx.beginPath();
      ctx.moveTo(x1,pad.t+ph);
      ctx.lineTo(x1,y1); ctx.lineTo(x2,y2); ctx.lineTo(x2,pad.t+ph);
      ctx.closePath(); ctx.fillStyle=grad; ctx.fill();

      ctx.beginPath();
      ctx.moveTo(x1,y1); ctx.lineTo(x2,y2);
      ctx.strokeStyle=line; ctx.lineWidth=4; ctx.lineCap="round"; ctx.lineJoin="round"; ctx.stroke();
    }

    // If every recorded value is zero, the line sits on the lower edge; draw a small
    // visible guide there so the chart line is still unmistakable.
    if(n > 1 && data.every(v => Number(v) === 0)){
      const yy = yAt(0);
      ctx.beginPath(); ctx.moveTo(xAt(0),yy); ctx.lineTo(xAt(n-1),yy);
      ctx.strokeStyle='#2E7CE6'; ctx.lineWidth=4; ctx.lineCap='round'; ctx.stroke();
    }

    // Points + last value
    for(let i=0;i<n;i++){
      const x=xAt(i), y=yAt(data[i]);
      ctx.beginPath(); ctx.arc(x,y,i===n-1?6:4,0,Math.PI*2);
      ctx.fillStyle="#9AA3B2"; ctx.fill();
    }
    const lastX=xAt(n-1), lastY=yAt(data[n-1]);
    ctx.font='bold 13px Vazirmatn, Tahoma, sans-serif';
    ctx.fillStyle=isLight ? "#232B3B" : "#EDEDED";
    ctx.textAlign="center";
    ctx.textBaseline="alphabetic";
    ctx.fillText(String(data[n-1]), lastX, lastY-pad.t<18 ? lastY+24 : lastY-12);

    // X labels: keep them readable and avoid overlap.
    ctx.font='10px Vazirmatn, Tahoma, sans-serif';
    ctx.fillStyle=textColor;
    ctx.textAlign="center";
    ctx.textBaseline="top";
    const step=Math.max(1,Math.ceil(n/8));
    for(let i=0;i<n;i+=step) ctx.fillText(String(labels[i]||""),xAt(i),h-pad.b+10);
    if((n-1)%step!==0) ctx.fillText(String(labels[n-1]||""),xAt(n-1),h-pad.b+10);
  };

  draw();
  if(canvas.__nativeChartResize) window.removeEventListener("resize", canvas.__nativeChartResize);
  canvas.__nativeChartResize = draw;
  window.addEventListener("resize", canvas.__nativeChartResize, {passive:true});
  return {destroy(){
    if(canvas.__nativeChartResize) window.removeEventListener("resize", canvas.__nativeChartResize);
    canvas.__nativeChartResize=null;
  }};
}

// ================= dashboard panel =================
async function renderDashboard(){
