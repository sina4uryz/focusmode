  else{
    let h = '';
    monthHistory.forEach(m=>{
      const weekBlocks = m.weeks.map((w,i)=>{
        const dayChips = w.dates.map((d,di)=>`<span class="week-day-chip">${iranWeekday(d)}: <b>${w.scores[di]}</b></span>`).join('');
        return `<div class="month-week-block">
          <div class="month-week-head">
            <span>هفته ${i+1}</span>
            <span class="month-week-score">${Math.round(w.score*10)/10} امتیاز</span>
            <span class="stamp ${w.cls}">${w.label} · ${w.grade}</span>
          </div>
          <div class="week-days mini">${dayChips}</div>
        </div>`;
      }).join('');

      // روزهای تفریحی (پنجشنبه/جمعه) که تو بازه‌ی همین ماه ثبت شدن ولی جزو هیچ هفته‌ی رسمی نیستن
      const monthStart = m.weeks[0].dates[0], monthEnd = m.weeks[3].dates[4];
      const funDates = sortedDates().filter(d=> d>=monthStart && d<=monthEnd && dailyRecords[d] && ['پنجشنبه','جمعه'].includes(dailyRecords[d].weekday));
      const funHtml = funDates.length ? `<div class="fun-days-block">
        <div class="fun-days-label">★ روزهای تفریحی همین بازه (حساب نمیشن)</div>
        <div class="fun-days-row">${funDates.map(d=>`<span class="fun-day-chip">${dailyRecords[d].weekday}: <b>${dailyRecords[d].dailyScore}</b></span>`).join('')}</div>
      </div>` : '';

      const chartId = 'monthChart_'+m.index;
      h+=`<div class="week-row">
        <div class="week-row-head">
          <span class="week-row-title">ماه ${m.index}</span>
          <span class="week-row-score">${Math.round(m.score*10)/10} امتیاز</span>
          <span class="stamp ${m.grade==='A+'?'good':(m.grade==='B+'?'mid':'bad')}">${m.label} · ${m.grade}</span>
        </div>
        ${weekBlocks}
        ${funHtml}
        <button type="button" class="month-chart-toggle" data-month-chart="${chartId}" data-month-index="${m.index}">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
          نمایش نمودار دوره
        </button>
        <div class="month-mini-chart hidden" id="${chartId}"><canvas></canvas></div>
      </div>`;
    });
    mWrap.innerHTML = h;
    mWrap.querySelectorAll('[data-month-chart]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const box = document.getElementById(btn.dataset.monthChart);
        const willOpen = box.classList.contains('hidden');
        box.classList.toggle('hidden');
        btn.classList.toggle('open', willOpen);
        if(willOpen && !box.dataset.drawn){
          const m = monthHistory.find(x=>String(x.index)===btn.dataset.monthIndex);
          const dates = m.weeks.flatMap(w=>w.dates);
          const labels = dates.map(d=>iranJalaliShort(d));
          const data = dates.map(d=>dailyRecords[d] ? dailyRecords[d].dailyScore : 0);
          const chartMode = localStorage.getItem('fm_chartMode') || 'duo';
          renderNativeDailyChart(box.querySelector('canvas'), labels, data, chartMode);
          box.dataset.drawn = '1';
        }
      });
    });
  }

  const ctx = document.getElementById('dailyChart');
  if(chartInstance){ chartInstance.destroy(); chartInstance = null; }
  const chartWrap = document.getElementById('chartWrap');
  const chartEmptyMsg = document.getElementById('chartEmptyMsg');

  // حالت نمودار: «دورنگ» (سبز/قرمز) یا «آبی» (تک‌رنگ) — هرکی داره می‌بینه (خودِ کاربر، منتور، یا رئیس)
  // مستقل از بقیه، ترجیح خودش رو رو همون مرورگرش ذخیره می‌کنه؛ روی داده یا نمایش بقیه اثر نمی‌ذاره.
  const chartMode = localStorage.getItem('fm_chartMode') || 'duo';
  const modeSwitch = document.getElementById('chartModeSwitch');
  if(modeSwitch){
    modeSwitch.querySelectorAll('button').forEach(b=>{
      b.classList.toggle('active', b.dataset.mode===chartMode);
      b.onclick = ()=>{ localStorage.setItem('fm_chartMode', b.dataset.mode); renderDashboard(); };
    });
  }

  if(!cycle){
    chartWrap.classList.add('hidden');
    chartEmptyMsg.classList.remove('hidden');
    return;
  }
  chartWrap.classList.remove('hidden');
  chartEmptyMsg.classList.add('hidden');
  const cycleDates = allCycleDates(cycleStart);
  const labels = cycleDates.map(d=>iranJalaliShort(d));
  const data = cycleDates.map(d=>dailyRecords[d] ? dailyRecords[d].dailyScore : 0);

  // همیشه اول همین‌جا و فوری (بدون نیاز به اینترنت/CDN) رسمش می‌کنیم — کاربر هیچ‌وقت معطل نمی‌مونه یا صفحه‌ی خالی نمی‌بینه
  renderNativeDailyChart(ctx, labels, data, chartMode);

  // در پس‌زمینه، نسخه‌ی شیک‌تر (Chart.js، با انیمیشن و گرید) رو هم امتحان می‌کنیم؛ اگه لود شد جایگزینش می‌کنیم
  const chartJsOk = await ensureChartJs();
  if(!chartJsOk) return; // نشد؟ عیبی نداره، همون نسخه‌ای که همین الان کشیدیم برای کاربر کافیه
  // اگه تا الان کاربر جای دیگه رفته یا این تابع دوباره صدا زده شده، این نسخه‌ی کندتر رو جایگزین نکن (جلوگیری از تداخل/فلیکر)
  if(document.getElementById('dailyChart') !== ctx) return;
  const weekIndexOf = (i)=>Math.floor(i/5);
  const weekBandsPlugin = {
    id:'weekBands',
    beforeDraw(chart){
      const {ctx, chartArea, scales:{x}} = chart;
      if(!chartArea) return;
      const n = labels.length;
      const bandColors = ['rgba(111,168,220,0.06)','rgba(233,234,236,0.04)'];
      let start = 0;
      while(start < n){
        const end = Math.min(start+4, n-1);
        const half = n>1 ? (x.getPixelForValue(1)-x.getPixelForValue(0))/2 : 20;
        const xStart = x.getPixelForValue(start)-half, xEnd = x.getPixelForValue(end)+half;
        ctx.save(); ctx.fillStyle = bandColors[weekIndexOf(start)%2];
        ctx.fillRect(xStart, chartArea.top, xEnd-xStart, chartArea.bottom-chartArea.top);
        ctx.restore();
        start += 5;
      }
    }
  };
  try{
    if(typeof Chart === 'undefined') throw new Error('chartjs-not-loaded');
    const trendColor = (ctx)=>{
      if(chartMode==='mono') return '#2E7CE6'; // حالت آبی — همون آبی پررنگ یکدست سایت، فرقی نمی‌کنه صعودی باشه یا نزولی
      const y0 = ctx.p0.parsed.y, y1 = ctx.p1.parsed.y;
      if(y1 > y0) return '#0F7B3D'; // صعودی → سبز تیره و پررنگ
      if(y1 < y0) return '#A81616'; // نزولی → قرمز تیره و پررنگ
      return '#9AA3B2'; // بدون تغییر → خاکستری
    };
    const trendFill = (sctx)=>{
      const chart = sctx.chart, area = chart.chartArea;
      if(!area) return 'rgba(154,163,178,0.05)';
      if(chartMode==='mono'){
        const g = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
        g.addColorStop(0,'rgba(46,124,230,0.30)'); g.addColorStop(1,'rgba(46,124,230,0.01)');
        return g;
      }
      const y0 = sctx.p0.parsed.y, y1 = sctx.p1.parsed.y;
      const g = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
      if(y1 > y0){ g.addColorStop(0,'rgba(15,123,61,0.30)'); g.addColorStop(1,'rgba(15,123,61,0.01)'); return g; }
      if(y1 < y0){ g.addColorStop(0,'rgba(168,22,22,0.30)'); g.addColorStop(1,'rgba(168,22,22,0.01)'); return g; }
      g.addColorStop(0,'rgba(154,163,178,0.10)'); g.addColorStop(1,'rgba(154,163,178,0.01)');
      return g;
    };
    // (هاله‌ی نور دور خط حذف شد — چون shadowBlur رو کنواس هر فریم گرون تمومه، خصوصاً حین انیمیشن ورودی، و باعث لگ می‌شد)

    // عددِ امروز، درست بالای آخرین نقطه
    const todayLabelPlugin = {
      id:'todayLabel',
      afterDatasetsDraw(chart){
        const meta = chart.getDatasetMeta(0);
        const last = meta.data[meta.data.length-1];
        if(!last) return;
        const {ctx} = chart;
        const val = data[data.length-1];
        ctx.save();
        ctx.font = '700 11px Vazirmatn, Tahoma, sans-serif';
        ctx.fillStyle = '#EDEDED';
        ctx.textAlign = 'center';
        const above = last.y - 18;
        ctx.fillText(String(val), last.x, above < (chart.chartArea.top+12) ? last.y + 24 : above);
        ctx.restore();
      }
    };
    // (سایه‌ی نور دور خط بردم — هم به‌خاطر ظاهر، هم چون با animation:false به‌درستی کار نمی‌کرد)
    chartInstance = new Chart(ctx, {
      type:'line',
      data:{ labels, datasets:[{ label:'امتیاز روزانه', data, borderColor:'#2E7CE6', backgroundColor:'rgba(46,124,230,0.12)',
        segment:{ borderColor: trendColor, backgroundColor: trendFill },
        pointBackgroundColor:'#9AA3B2',
        pointBorderColor:'transparent', pointBorderWidth:0,
        pointRadius:(c)=> c.dataIndex===data.length-1 ? 7 : 4.8,
        pointHoverRadius:8, borderWidth:4, borderJoinStyle:'round', borderCapStyle:'round',
        tension:0, fill:true }] },
      options:{ responsive:true, maintainAspectRatio:false, devicePixelRatio:window.devicePixelRatio||1, plugins:{ legend:{display:false}, tooltip:{rtl:true} },
        // انیمیشن ورودِ خط از چپ به راست — انگار داره لحظه‌به‌لحظه کشیده میشه تا برسه به نقطه‌ی آخر
        animation:false,
        scales:{ y:{min:0,max:100,ticks:{color:'#B8C0CC',stepSize:10},grid:{color:'#454E62'}}, x:{ticks:{color:'#B8C0CC',font:{size:10.5}},grid:{display:false}} } },
      plugins:[weekBandsPlugin, todayLabelPlugin]
    });
  }catch(e){
    console.error('chart render failed, using native fallback', e);
    chartWrap.classList.remove('hidden');
    chartEmptyMsg.classList.add('hidden');
    try { renderNativeDailyChart(ctx, labels, data); }
    catch(nativeErr){
      console.error('native chart render failed', nativeErr);
      chartEmptyMsg.classList.remove('hidden');
      chartEmptyMsg.innerHTML = 'خطا در رسم نمودار — دوباره صفحه را باز کن';
    }
  }
}

